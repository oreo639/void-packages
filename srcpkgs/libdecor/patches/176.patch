+static int
+libdecor_pidfd_send_signal(int pidfd, int sig, siginfo_t *info,
+			   unsigned int flags)
+{
+	return syscall(SYS_pidfd_send_signal, pidfd, sig, info, flags);
+}
+
+static void
+libdecor_plugin_gtk4_destroy(struct libdecor_plugin *plugin)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 =
+		(struct libdecor_plugin_gtk4 *) plugin;
+	struct dispatcher *dispatcher, *tmp;
+
+	wl_list_for_each_safe(dispatcher, tmp, &plugin_gtk4->dispatchers, link)
+		free(dispatcher);
+
+	if (plugin_gtk4->client_pidfd >= 0) {
+		siginfo_t siginfo = {};
+
+		if (libdecor_pidfd_send_signal(plugin_gtk4->client_pidfd,
+					       SIGTERM, NULL, 0) != 0) {
+			fprintf(stderr,
+				"libdecor-WARNING: "
+				"Failed to terminate client with pidfd (%s), "
+				"trying pid.\n",
+				strerror(errno));
+			kill(plugin_gtk4->client_pid, SIGTERM);
+		}
+		waitid(P_PIDFD, plugin_gtk4->client_pidfd, &siginfo, WEXITED);
+	}
+
+	if (plugin_gtk4->epoll_fd > 0)
+		close(plugin_gtk4->epoll_fd);
+
+	libdecor_gtk4_tunnels_free(plugin_gtk4->tunnels);
+
+	if (plugin_gtk4->wl_client)
+		wl_client_destroy(plugin_gtk4->wl_client);
+
+	if (plugin_gtk4->client.wl_subcompositor)
+		wl_subcompositor_destroy(plugin_gtk4->client.wl_subcompositor);
+	if (plugin_gtk4->client.wl_registry)
+		wl_registry_destroy(plugin_gtk4->client.wl_registry);
+	wl_proxy_wrapper_destroy(plugin_gtk4->client.wl_display);
+	wl_event_queue_destroy(plugin_gtk4->client.wl_event_queue);
+
+	if (plugin_gtk4->server.wl_display)
+		wl_display_destroy(plugin_gtk4->server.wl_display);
+
+	libdecor_plugin_release(&plugin_gtk4->plugin);
+	free(plugin_gtk4);
+}
+
+static int
+libdecor_plugin_gtk4_get_fd(struct libdecor_plugin *plugin)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 =
+		(struct libdecor_plugin_gtk4 *) plugin;
+
+	return plugin_gtk4->epoll_fd;
+}
+
+static void
+dispatch_event_loop(void *data, int events, struct dispatch_state *state)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 = data;
+	struct wl_event_loop *event_loop;
+
+	event_loop = wl_display_get_event_loop(plugin_gtk4->server.wl_display);
+	if (wl_event_loop_dispatch(event_loop, 0) != 0) {
+		fprintf(stderr, "libdecor-ERROR: Failed to dispatch event loop: %s\n",
+			strerror(errno));
+		exit(EXIT_FAILURE);
+	}
+}
+
+static int
+prepare_client_display(struct libdecor_plugin_gtk4 *plugin_gtk4,
+		       struct dispatch_state *state)
+{
+	struct wl_display *wl_display = libdecor_get_wl_display(plugin_gtk4->context);
+	struct wl_event_queue *plugin_queue;
+
+	plugin_queue = plugin_gtk4->client.wl_event_queue;
+
+	while (true) {
+		int count;
+
+		if (wl_display_prepare_read_queue(wl_display, plugin_queue) != 0)
+			goto dispatch_pending;
+
+		if (!plugin_gtk4->client.plugin_queue_only) {
+			if (wl_display_prepare_read(wl_display) != 0) {
+				wl_display_cancel_read(wl_display);
+				goto dispatch_pending;
+			}
+		}
+
+		break;
+dispatch_pending:
+		count = wl_display_dispatch_queue_pending(wl_display, plugin_queue);
+		if (count == -1)
+			break;
+		state->dispatch_count += count;
+
+		if (!plugin_gtk4->client.plugin_queue_only) {
+			count = wl_display_dispatch_pending(wl_display);
+			if (count == -1) {
+				fprintf(stderr,
+					"libdecor-ERROR: Failed to dispatch Wayland queue: %s\n",
+					strerror(errno));
+
+				break;
+			}
+			state->dispatch_count += count;
+		}
+	}
+
+	plugin_gtk4->client.prepared_to_read = true;
+
+	if (wl_display_get_error(wl_display) == 0)
+		return 0;
+	else
+		return -1;
+}
+
+static void
+dispatch_client_display(void *data, int events, struct dispatch_state *state)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 = data;
+	struct wl_display *wl_display = libdecor_get_wl_display(plugin_gtk4->context);
+	struct wl_event_queue *plugin_queue;
+	int ret;
+
+	if (events & EPOLLIN) {
+		if (!plugin_gtk4->client.plugin_queue_only)
+			wl_display_cancel_read(wl_display);
+		if (wl_display_read_events(wl_display) != 0) {
+			state->dispatch_errno = errno;
+			return;
+		}
+	} else {
+		wl_display_cancel_read(wl_display);
+		if (!plugin_gtk4->client.plugin_queue_only)
+			wl_display_cancel_read(wl_display);
+	}
+
+	plugin_gtk4->client.prepared_to_read = false;
+
+	plugin_queue = plugin_gtk4->client.wl_event_queue;
+	ret = wl_display_dispatch_queue_pending(wl_display, plugin_queue);
+	if (ret == -1) {
+		state->dispatch_errno = errno;
+		return;
+	}
+	state->dispatch_count += ret;
+
+	if (!plugin_gtk4->client.plugin_queue_only) {
+		ret = wl_display_dispatch_pending(wl_display);
+		if (ret == -1) {
+			state->dispatch_errno = errno;
+			return;
+		}
+		state->dispatch_count += ret;
+	}
+}
+
+static void
+skip_client_display(void *data, struct dispatch_state *state)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 = data;
+	struct wl_display *wl_display = libdecor_get_wl_display(plugin_gtk4->context);
+
+	if (plugin_gtk4->client.prepared_to_read) {
+		wl_display_cancel_read(wl_display);
+		if (!plugin_gtk4->client.plugin_queue_only)
+			wl_display_cancel_read(wl_display);
+		plugin_gtk4->client.prepared_to_read = false;
+	}
+}
+
+static int
+libdecor_plugin_gtk4_dispatch(struct libdecor_plugin *plugin,
+			      int timeout)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 =
+		(struct libdecor_plugin_gtk4 *) plugin;
+	struct wl_display *wl_display = libdecor_get_wl_display(plugin_gtk4->context);
+	struct epoll_event ep[16] = {};
+	int count;
+	int i;
+	struct dispatch_state state = {};
+
+	if (prepare_client_display(plugin_gtk4, &state) != 0)
+		return -errno;
+
+	wl_display_flush_clients(plugin_gtk4->server.wl_display);
+
+	if (wl_display_flush(wl_display) < 0)
+		return -errno;
+
+	count = epoll_wait(plugin_gtk4->epoll_fd, ep, ARRAY_LENGTH(ep), timeout);
+	struct dispatcher *dispatcher;
+	wl_list_for_each(dispatcher, &plugin_gtk4->dispatchers, link) {
+		for (i = 0; i < count; i++) {
+			struct dispatcher *ready_dispatcher = ep[i].data.ptr;
+
+			if (ready_dispatcher == dispatcher)
+				break;
+		}
+		if (i == count) {
+			if (dispatcher->skip)
+				dispatcher->skip(dispatcher->user_data, &state);
+			continue;
+		}
+
+		dispatcher->dispatch(dispatcher->user_data, ep[i].events, &state);
+	}
+
+	if (state.dispatch_errno) {
+		errno = state.dispatch_errno;
+		return -errno;
+	}
+
+	return state.dispatch_count;
+}
+
+static void
+dispatch_plugin_only(struct libdecor_plugin_gtk4 *plugin_gtk4)
+{
+	plugin_gtk4->client.plugin_queue_only = true;
+	libdecor_plugin_gtk4_dispatch(&plugin_gtk4->plugin, -1);
+	plugin_gtk4->client.plugin_queue_only = false;
+}
