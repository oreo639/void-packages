+static void
+libdecor_shell_handle_create_frame(struct wl_client *wl_client,
+				   struct wl_resource *resource,
+				   uint32_t id,
+				   uint32_t serial,
+				   struct wl_resource *wl_surface_resource)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(wl_surface_resource);
+	struct libdecor_gtk4_surface *surface = surface_tunnel_object->user_data;
+	struct libdecor_gtk4_frame_surface *frame_surface = surface->frame_surface;
+	struct libdecor_plugin_gtk4 *plugin_gtk4 = frame_surface->plugin_gtk4;
+	struct libdecor_frame_gtk4 *frame_gtk4;
+
+	frame_gtk4 = find_frame(plugin_gtk4, serial);
+	if (!frame_gtk4)
+		return;
+
+	frame_gtk4 = frame_gtk4;
+	frame_gtk4->frame_surface = frame_surface;
+	frame_surface->frame_gtk4 = frame_gtk4;
+
+	frame_surface->server.shell_surface_resource =
+		wl_resource_create(wl_client, &libdecor_shell_surface_interface,
+				   wl_resource_get_version(resource), id);
+	wl_resource_set_implementation(frame_surface->server.shell_surface_resource,
+				       &libdecor_shell_surface_implementation,
+				       libdecor_gtk4_frame_surface_ref (frame_surface),
+				       destroy_frame_surface);
+}
