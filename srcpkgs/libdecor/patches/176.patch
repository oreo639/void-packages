+struct libdecor_gtk4_frame_surface {
+	int ref_count;
+
+	struct libdecor_plugin_gtk4 *plugin_gtk4;
+	struct libdecor_frame_gtk4 *frame_gtk4;
+
+	struct libdecor_gtk4_surface *surface;
+
+	struct {
+		struct wl_resource *xdg_surface_resource;
+		struct wl_resource *xdg_toplevel_resource;
+		struct wl_resource *shell_surface_resource;
+	} server;
+
+	struct {
+		struct wl_subsurface *subsurface;
+	} client;
+
+	uint32_t last_sent_configure_serial;
+
+	struct wl_listener before_commit_listener;
+	struct wl_listener after_commit_listener;
+
+	struct frame_surface_state pending_state;
+	struct frame_surface_state current_state;
+	int subsurface_x;
+	int subsurface_y;
+
+	bool is_sync;
+	bool in_commit;
+};
