+ * NONINFRINGEMENT.  IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS
+ * BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN
+ * ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+#include "config.h"
+
+#include <assert.h>
+#include <dlfcn.h>
+#include <gdk/wayland/gdkwayland.h>
+#include <gtk/gtk.h>
+
+#include "utils.h"
+
+#include "libdecor-shell-client-protocol.h"
+
+static struct libdecor_shell *libdecor_shell;
+static struct wl_display *libdecor_shell_display;
+
+static void *libwayland_client = NULL;
+
+struct frame_window {
+	GtkWidget *window;
+	struct libdecor_shell_surface *shell_surface;
+};
+
+WL_EXPORT struct wl_display *
+wl_display_connect(const char *name);
+
+WL_EXPORT struct wl_proxy *
+wl_proxy_marshal_array_flags(struct wl_proxy *proxy, uint32_t opcode,
+			     const struct wl_interface *interface, uint32_t version,
+			     uint32_t flags, union wl_argument *args);
+
+static const struct wl_registry_listener registry_listener;
+
+static void *
+ensure_libwayland_client(void)
+{
+	if (!libwayland_client) {
+		libwayland_client = dlopen("libwayland-client.so.0", RTLD_LAZY);
+		if (!libwayland_client) {
+			perror("Cannot load libwayland-client.so.0");
+			abort();
+		}
+	}
+	return libwayland_client;
+}
+
+static void
+ensure_libdecor_shell(struct wl_display *wl_display)
+{
+	struct wl_registry *wl_registry;
+
+	if (libdecor_shell)
+		return;
+
+	libdecor_shell_display = wl_display;
+	wl_registry = wl_display_get_registry(wl_display);
+	wl_registry_add_listener(wl_registry,
+				 &registry_listener,
+				 NULL);
+	wl_display_roundtrip(wl_display);
+	assert(libdecor_shell);
+}
+
+struct wl_display *
+wl_display_connect(const char *name)
+{
+	static struct wl_display * (* real_display_connect) (const char *name) = NULL;
+	struct wl_display *wl_display;
+
+	if (!real_display_connect) {
+		libwayland_client = ensure_libwayland_client();
+
+		real_display_connect = dlsym(libwayland_client,
+					     "wl_display_connect");
+		if (!real_display_connect) {
+			perror("Cannot find wl_display_connect symbol");
+			abort();
+		}
+	}
+
+	wl_display = real_display_connect(name);
+	if (wl_display)
+		ensure_libdecor_shell(wl_display);
+	return wl_display;
+}
+
+struct wl_display *
+wl_display_connect_to_fd(int fd)
+{
+	static struct wl_display * (* real_display_connect_fd) (int fd) = NULL;
+	struct wl_display *wl_display;
+
+	if (!real_display_connect_fd) {
+		libwayland_client = ensure_libwayland_client();
+
+		real_display_connect_fd = dlsym(libwayland_client,
+					     "wl_display_connect_to_fd");
+		if (!real_display_connect_fd) {
+			perror("Cannot find wl_display_connect_to_fd symbol");
+			abort();
+		}
+	}
+
+	wl_display = real_display_connect_fd(fd);
+	if (wl_display)
+		ensure_libdecor_shell(wl_display);
+	return wl_display;
+}
+
+struct wl_proxy *
+wl_proxy_marshal_array_flags(struct wl_proxy *proxy, uint32_t opcode,
+			     const struct wl_interface *interface, uint32_t version,
+			     uint32_t flags, union wl_argument *args)
+{
+	static struct wl_proxy * (* real_marshal_array_flags)(struct wl_proxy *proxy,
+							      uint32_t opcode,
+							      const struct wl_interface *interface,
+							      uint32_t version,
+							      uint32_t flags,
+							      union wl_argument *args) = NULL;
+
+	if (!real_marshal_array_flags) {
+		libwayland_client = ensure_libwayland_client();
+
+		real_marshal_array_flags = dlsym(libwayland_client,
+						 "wl_proxy_marshal_array_flags");
+		if (!real_marshal_array_flags) {
+			perror("Cannot find wl_proxy_marshal_array_flags symbol");
+			abort();
+		}
+	}
+
+	if (wl_proxy_get_interface(proxy) == &wl_display_interface &&
+	    wl_proxy_get_display(proxy) == libdecor_shell_display &&
+	    opcode == WL_DISPLAY_SYNC &&
+	    libdecor_shell) {
+		struct wl_proxy *wrapper = wl_proxy_create_wrapper(libdecor_shell);
+		struct wl_proxy *callback;
+
+		wl_proxy_set_queue(wrapper, wl_proxy_get_queue(proxy));
+		callback = real_marshal_array_flags(wrapper,
+						    LIBDECOR_SHELL_SYNC,
+						    &libdecor_shell_interface,
+						    libdecor_shell_get_version(libdecor_shell),
+						    flags, args);
+		wl_proxy_wrapper_destroy(wrapper);
+		return callback;
+	}
+
+
+	return real_marshal_array_flags(proxy, opcode, interface, version, flags, args);
+}
+
+static void
+on_after_layout(GdkFrameClock *clock,
+		int width,
+		int height,
+		struct frame_window *frame_window)
+{
+	GtkWidget *widget;
+	GtkWidget *native;
+	double native_x, native_y;
+	graphene_rect_t widget_bounds;
+	graphene_point_t content_origin;
+	graphene_point_t content_offset;
+
+	widget = gtk_window_get_child(GTK_WINDOW(frame_window->window));
+
+	native = GTK_WIDGET(gtk_widget_get_native(widget));
+	gtk_native_get_surface_transform(GTK_NATIVE(native), &native_x, &native_y);
+	if (!gtk_widget_compute_bounds(widget, frame_window->window, &widget_bounds))
+		return;
+
+	content_origin.x = 0;
+	content_origin.y = 0;
+	if (!gtk_widget_compute_point(widget, frame_window->window,
+				      &content_origin,
+				      &content_offset))
+		return;
+
+	libdecor_shell_surface_set_content_area(frame_window->shell_surface,
+						(int) floor(widget_bounds.origin.x),
+						(int) floor(widget_bounds.origin.y),
+						(int) floor(widget_bounds.size.width),
+						(int) floor(widget_bounds.size.height),
+						(int) roundf(native_x),
+						(int) roundf(native_y),
+						width, height);
+}
+
+static void
+libdecor_shell_surface_handle_configure_content(void *data,
+						struct libdecor_shell_surface *libdecor_shell_surface,
+						int32_t width,
+						int32_t height)
+{
+	struct frame_window *frame_window = data;
+	GtkWidget *widget =
+		gtk_window_get_child(GTK_WINDOW(frame_window->window));
+
+	if (width == 0 && height == 0) {
+		gtk_widget_set_size_request(widget, 1, 1);
+	} else {
+		gtk_widget_set_size_request(widget, width, height);
+		gtk_widget_set_size_request(frame_window->window, 1, 1);
+		gtk_window_set_default_size(GTK_WINDOW(frame_window->window), 1, 1);
+	}
+	
+}
+
+static void
+libdecor_shell_surface_handle_configure_title(void *data,
+					      struct libdecor_shell_surface *libdecor_shell_surface,
+					      const char *title)
+{
+	struct frame_window *frame_window = data;
+
+	gtk_window_set_title(GTK_WINDOW(frame_window->window), title);
+}
+
+static void
+libdecor_shell_surface_handle_dismiss(void *data,
+				      struct libdecor_shell_surface *libdecor_shell_surface)
+{
+	struct frame_window *frame_window = data;
+
+	gtk_window_destroy(GTK_WINDOW(frame_window->window));
+}
+
+static struct libdecor_shell_surface_listener libdecor_shell_surface_listener = {
+	.configure_content = libdecor_shell_surface_handle_configure_content,
+	.configure_title = libdecor_shell_surface_handle_configure_title,
+	.dismiss = libdecor_shell_surface_handle_dismiss,
+};
+
+static gboolean
+on_close_requested(GtkWindow *window,
+		   struct frame_window *frame_window)
+{
+	libdecor_shell_surface_close(frame_window->shell_surface);
+	return TRUE;
+}
+
+static void
+libdecor_shell_handle_request_frame(void *data,
+				    struct libdecor_shell *libdecor_shell,
+				    uint32_t serial)
+{
+	struct frame_window *frame_window;
+	GtkWidget *window;
+	GtkWidget *widget;
+	GdkSurface *surface;
+	struct wl_surface *wl_surface;
+
+	window = gtk_window_new();
+	frame_window = zalloc(sizeof *frame_window);
+	frame_window->window = window;
+
+	g_signal_connect(window, "close-request",
+			 G_CALLBACK(on_close_requested), frame_window);
+
+	widget = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+	gtk_window_set_child(GTK_WINDOW(window), widget);
+	gtk_window_present(GTK_WINDOW(window));
+
+	if (libdecor_strcmp0(getenv("LIBDECOR_DEBUG_GTK4_INSPECTOR"), "1") == 0)
+		gtk_window_set_interactive_debugging(TRUE);
+
+	surface = gtk_native_get_surface(GTK_NATIVE(window));
+
+	g_signal_connect_after(surface, "layout", G_CALLBACK(on_after_layout),
+			       frame_window);
+
+	wl_surface = gdk_wayland_surface_get_wl_surface(surface);
+	
+	frame_window->shell_surface = libdecor_shell_create_frame(libdecor_shell,
+								  serial,
+								  wl_surface);
+	libdecor_shell_surface_add_listener(frame_window->shell_surface,
+					    &libdecor_shell_surface_listener,
+					    frame_window);
+}
+
+static void
+libdecor_shell_handle_terminate(void *data,
+				struct libdecor_shell *libdecor_shell)
+{
+	exit(EXIT_SUCCESS);
+}
+
+static struct libdecor_shell_listener libdecor_shell_listener = {
+	.request_frame = libdecor_shell_handle_request_frame,
+	.terminate = libdecor_shell_handle_terminate,
+};
+
+static void
+registry_handle_global(void *user_data,
+		       struct wl_registry *wl_registry,
+		       uint32_t id,
+		       const char *interface,
+		       uint32_t version)
+{
+	if (strcmp(interface, "libdecor_shell") == 0) {
+		libdecor_shell =
+			wl_registry_bind(wl_registry, id,
+					 &libdecor_shell_interface, 1);
+		libdecor_shell_add_listener(libdecor_shell,
+					    &libdecor_shell_listener,
+					    NULL);
+	}
+}
+
+static void
+registry_handle_global_remove(void *user_data,
+			      struct wl_registry *wl_registry,
+			      uint32_t name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+	registry_handle_global,
+	registry_handle_global_remove
+};
+
+static void
+update_header_bar_geometry(void)
+{
+	GtkWidget *window;
+	GtkWidget *widget;
+	int child_min = 0, child_nat = 0;
+
+	window = g_object_ref_sink(gtk_window_new());
+	widget = gtk_header_bar_new ();
+	gtk_window_set_child(GTK_WINDOW(window), widget);
+	gtk_widget_add_css_class (widget, "titlebar");
+	gtk_widget_add_css_class (widget, "default-decoration");
+	gtk_widget_measure(widget, GTK_ORIENTATION_VERTICAL, -1,
+			   &child_min, &child_nat, NULL, NULL);
+	libdecor_shell_titlebar_geometry(libdecor_shell, child_nat);
+	g_object_unref(window);
+}
+
+int
+main(int argc, char **argv)
+{
+	GMainLoop *loop;
+	const char *wayland_debug;
+
+	unsetenv("WAYLAND_DISPLAY");
+	unsetenv("DISPLAY");
+
+	wayland_debug = getenv("LIBDECOR_DEBUG_GTK4_WAYLAND_DEBUG");
+	if (wayland_debug)
+		setenv("WAYLAND_DEBUG", wayland_debug, 1);
+	else
+		unsetenv("WAYLAND_DEBUG");
+
+	gdk_set_allowed_backends("wayland");
+	if (!gtk_init_check ()) {
+		fprintf(stderr, "Failed to initialize GTK, exiting.\n");
+		return EXIT_FAILURE;
+	}
+
+	if (!libdecor_shell) {
+		fprintf(stderr, "Missing libdecor_shell global, exiting.\n");
+		return EXIT_FAILURE;
+	}
+
+	update_header_bar_geometry ();
+
+	libdecor_shell_ready(libdecor_shell);
+
+	loop = g_main_loop_new(NULL, FALSE);
+	g_main_loop_run(loop);
+	return EXIT_SUCCESS;
+}
