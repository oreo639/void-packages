From cbc92987c4886db0a4c8d74ebe30918c394df811 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Mon, 30 Mar 2026 15:24:30 +0200
Subject: [PATCH 17/20] gtk4: Send xdg_toplevel.wm_capabilities

This bumps the version to 5, and plumbs the window manager capabilities
to the GTK4 client so that it can correctly mark the corresponding
window action widgets active/inactive.
---
 src/plugins/gtk4/libdecor-gtk4.c | 60 +++++++++++++++++++++++++++++++-
 1 file changed, 59 insertions(+), 1 deletion(-)

diff --git a/src/plugins/gtk4/libdecor-gtk4.c b/src/plugins/gtk4/libdecor-gtk4.c
index 99671e5..c892534 100644
--- a/src/plugins/gtk4/libdecor-gtk4.c
+++ b/src/plugins/gtk4/libdecor-gtk4.c
@@ -50,7 +50,7 @@
 #include "xdg-shell-server-protocol.h"
 #include "libdecor-shell-server-protocol.h"
 
-#define XDG_WM_BASE_VERSION 3
+#define XDG_WM_BASE_VERSION 5
 #define LIBDECOR_SHELL_VERSION 1
 
 struct dispatch_state {
@@ -78,6 +78,7 @@ struct libdecor_frame_gtk4 {
 	struct wl_list link;
 
 	char *title;
+	enum libdecor_wm_capabilities wm_capabilities;
 };
 
 struct libdecor_plugin_gtk4 {
@@ -717,6 +718,52 @@ libdecor_plugin_gtk4_frame_commit(struct libdecor_plugin *plugin,
 	frame_surface->in_commit = false;
 }
 
+static void
+add_wm_capabilities(struct wl_array *xdg_wm_capabilities,
+		    enum libdecor_wm_capabilities wm_capabilities)
+{
+	if (wm_capabilities & LIBDECOR_WM_CAPABILITIES_WINDOW_MENU) {
+		add_uint32_to_array(xdg_wm_capabilities,
+				    XDG_TOPLEVEL_WM_CAPABILITIES_WINDOW_MENU);
+	}
+	if (wm_capabilities & LIBDECOR_WM_CAPABILITIES_MAXIMIZE) {
+		add_uint32_to_array(xdg_wm_capabilities,
+				    XDG_TOPLEVEL_WM_CAPABILITIES_MAXIMIZE);
+	}
+	if (wm_capabilities & LIBDECOR_WM_CAPABILITIES_FULLSCREEN) {
+		add_uint32_to_array(xdg_wm_capabilities,
+				    XDG_TOPLEVEL_WM_CAPABILITIES_FULLSCREEN);
+	}
+	if (wm_capabilities & LIBDECOR_WM_CAPABILITIES_MINIMIZE) {
+		add_uint32_to_array(xdg_wm_capabilities,
+				    XDG_TOPLEVEL_WM_CAPABILITIES_MINIMIZE);
+	}
+}
+
+static void
+send_wm_capabilities(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4;
+	struct wl_resource *toplevel_resource;
+	struct wl_array xdg_wm_capabilities;
+
+	toplevel_resource = frame_surface->server.xdg_toplevel_resource;
+	if (wl_resource_get_version(toplevel_resource) <
+	    XDG_TOPLEVEL_WM_CAPABILITIES_SINCE_VERSION)
+		return;
+
+	frame_gtk4 = frame_surface->frame_gtk4;
+	if (!frame_gtk4)
+		return;
+
+	wl_array_init(&xdg_wm_capabilities);
+	add_wm_capabilities(&xdg_wm_capabilities,
+			    frame_gtk4->wm_capabilities);
+	xdg_toplevel_send_wm_capabilities(toplevel_resource,
+					  &xdg_wm_capabilities);
+	wl_array_release(&xdg_wm_capabilities);
+}
+
 static void
 libdecor_plugin_gtk4_frame_property_changed(struct libdecor_plugin *plugin,
 					    struct libdecor_frame *frame)
@@ -733,6 +780,13 @@ libdecor_plugin_gtk4_frame_property_changed(struct libdecor_plugin *plugin,
 		set_string(&frame_gtk4->title, title);
 		libdecor_shell_surface_send_configure_title(shell_surface, title);
 	}
+
+	if (libdecor_frame_get_wm_capabilities(frame) !=
+	    frame_gtk4->wm_capabilities) {
+		frame_gtk4->wm_capabilities =
+			libdecor_frame_get_wm_capabilities(frame);
+		send_wm_capabilities(frame_surface);
+	}
 }
 
 static struct libdecor_gtk4_seat *
@@ -1109,6 +1163,8 @@ xdg_surface_handle_get_toplevel(struct wl_client *wl_client,
 				       &xdg_toplevel_implementation,
 				       libdecor_gtk4_frame_surface_ref (frame_surface),
 				       destroy_xdg_toplevel);
+
+	send_wm_capabilities(frame_surface);
 }
 
 static void
@@ -1430,6 +1486,8 @@ libdecor_shell_handle_create_frame(struct wl_client *wl_client,
 				       &libdecor_shell_surface_implementation,
 				       libdecor_gtk4_frame_surface_ref (frame_surface),
 				       destroy_frame_surface);
+
+	send_wm_capabilities(frame_surface);
 }
 
 static void
-- 
