+ * SOFTWARE.
+ */
+
+#include "config.h"
+
+#include "libdecor-gtk4.h"
+#include "libdecor-plugin.h"
+#include "utils.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <wayland-client.h>
+#include <wayland-server.h>
+#include <unistd.h>
+
+#include "linux-dmabuf-v1-tunnel.h"
+#include "cursor-shape-v1-tunnel.h"
+#include "tablet-v2-tunnel.h"
+#include "wayland-drm-tunnel.h"
+#include "wayland-tunnel.h"
+
+#define MAX_COMPOSITOR_VERSION 5
+
+const char *libdecor_gtk4_proxy_tag = "libdecor-plugin-gtk4";
+
+struct libdecor_gtk4_tunnel_object *
+libdecor_gtk4_tunnel_object_new(struct libdecor_gtk4_tunnels *tunnels,
+				struct libdecor_gtk4_tunnel_object *parent,
+				void *proxy,
+				struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *object;
+
+	object = zalloc(sizeof(*object));
+	if (!object)
+		return NULL;
+
+	wl_list_init(&object->link);
+	wl_list_init(&object->children);
+	if (parent) {
+		object->parent = parent;
+		wl_list_insert(&parent->children, &object->link);
+	}
+	object->tunnels = tunnels;
+	object->proxy = proxy;
+	object->resource = resource;
+
+	return object;
+}
+
+void
+libdecor_gtk4_tunnel_object_free(struct libdecor_gtk4_tunnel_object *object)
+{
+	struct libdecor_gtk4_tunnel_object *child, *tmp;
+
+	wl_list_remove(&object->link);
+	wl_list_for_each_safe(child, tmp, &object->children, link) {
+		wl_list_remove(&child->link);
+		if (object->parent) {
+			wl_list_insert(&object->parent->children, &child->link);
+			child->parent = object->parent;
+		} else {
+			wl_list_init(&child->link);
+			child->parent = NULL;
+		}
+	}
+	if (object->free_user_data)
+		object->free_user_data(object->user_data);
+
+	free(object);
+}
+
+static void
+libdecor_gtk4_global_free(struct libdecor_gtk4_global *global)
+{
+	wl_global_destroy(global->wl_global);
+	wl_list_remove(&global->link);
+	free(global);
+}
+
+static void
+surface_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_destroy(tunnel_object->proxy);
+	wl_resource_destroy(tunnel_object->resource);
+}
+
+static void
+surface_attach(struct wl_client *client,
+	       struct wl_resource *resource,
+	       struct wl_resource *buffer_resource, int32_t sx, int32_t sy)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_tunnel_object *buffer = NULL;
+
+	if (buffer_resource)
+		buffer = wl_resource_get_user_data(buffer_resource);
+	wl_surface_attach(surface_tunnel_object->proxy,
+			  buffer ? buffer->proxy : NULL,
+			  sx, sy);
+}
+
+static void
+surface_damage(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t x, int32_t y, int32_t width, int32_t height)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_damage(surface_tunnel_object->proxy, x, y, width, height);
+}
+
+static void
+surface_damage_buffer(struct wl_client *client,
+		      struct wl_resource *resource,
+		      int32_t x, int32_t y, int32_t width, int32_t height)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_damage_buffer(surface_tunnel_object->proxy, x, y, width, height);
+}
+
+static void
+destroy_callback(void *user_data)
+{
+	struct libdecor_gtk4_callback *callback = user_data;
+
+	wl_list_remove(&callback->link);
+	free(callback);
+}
+
+static void
+surface_frame(struct wl_client *client,
+	      struct wl_resource *resource,
+	      uint32_t id)
+
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct wl_resource *callback_resource;
+	struct wl_callback *callback_proxy;
+	struct libdecor_gtk4_tunnel_object *callback_tunnel_object;
+	struct libdecor_gtk4_surface *surface;
+	struct libdecor_gtk4_callback *callback;
+
+	callback_resource =
+		wl_resource_create(client, &wl_callback_interface, 1, id);
+
+	if (!surface_tunnel_object)
+		return;
+
+	surface = surface_tunnel_object->user_data;
+
+	callback_proxy = wl_surface_frame(surface_tunnel_object->proxy);
+
+	callback_tunnel_object =
+		libdecor_gtk4_tunnel_object_new(surface_tunnel_object->tunnels,
+						surface_tunnel_object,
+						callback_proxy, callback_resource);
+	wl_callback_add_listener(callback_proxy,
+				 &wl_callback_listener,
+				 callback_tunnel_object);
+	wl_resource_set_implementation (callback_tunnel_object->resource, NULL,
+					callback_tunnel_object,
+					destroy_wl_callback);
+
+	callback = zalloc(sizeof *callback);
+	callback->tunnel_object = callback_tunnel_object;
+	wl_list_insert(&surface->pending_frame_callbacks, &callback->link);
+	callback_tunnel_object->user_data = callback;
+	callback_tunnel_object->free_user_data = destroy_callback;
+}
+
+static void
+surface_set_opaque_region(struct wl_client *client,
+			  struct wl_resource *resource,
+			  struct wl_resource *region_resource)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(region_resource);
+
+	wl_surface_set_opaque_region(surface_tunnel_object->proxy,
+				     region->proxy);
+}
+
+static void
+surface_set_input_region(struct wl_client *client,
+			 struct wl_resource *resource,
+			 struct wl_resource *region_resource)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(region_resource);
+
+	wl_surface_set_input_region(surface_tunnel_object->proxy, region->proxy);
+}
+
+static void
+surface_commit(struct wl_client *client, struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_surface *surface = surface_tunnel_object->user_data;
+
+	wl_signal_emit(&surface->before_commit_signal, surface);
+	wl_surface_commit(surface_tunnel_object->proxy);
+	wl_signal_emit(&surface->after_commit_signal, surface);
+}
+
+static void
+surface_set_buffer_transform(struct wl_client *client,
+			     struct wl_resource *resource, int transform)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_set_buffer_transform(surface_tunnel_object->proxy, transform);
+}
+
+static void
+surface_set_buffer_scale(struct wl_client *client,
+			 struct wl_resource *resource,
+			 int32_t scale)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_set_buffer_scale(surface_tunnel_object->proxy, scale);
+}
+
+static void
+surface_offset(struct wl_client *client,
+	       struct wl_resource *resource,
+	       int32_t sx,
+	       int32_t sy)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	wl_surface_offset(surface_tunnel_object->proxy, sx, sy);
+}
+
+static const struct wl_surface_interface surface_interface = {
+	surface_destroy,
+	surface_attach,
+	surface_damage,
+	surface_frame,
+	surface_set_opaque_region,
+	surface_set_input_region,
+	surface_commit,
+	surface_set_buffer_transform,
+	surface_set_buffer_scale,
+	surface_damage_buffer,
+	surface_offset,
+};
+
+static void
+destroy_surface(struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_surface *surface = surface_tunnel_object->user_data;
+	struct libdecor_gtk4_tunnel_object *tunnel_object;
+
+	wl_list_for_each(tunnel_object,
+			 &surface_tunnel_object->tunnels->root_tunnel_object->children,
+			 link) {
+		struct libdecor_gtk4_seat *seat;
+
+		if (wl_resource_get_interface(tunnel_object->resource) !=
+		    &wl_seat_interface)
+			continue;
+
+		seat = tunnel_object->user_data;
+		if (!seat)
+			continue;
+
+		if (seat->pointer_focus == surface)
+			seat->pointer_focus = NULL;
+	}
+
+	if (surface->frame_surface)
+		libdecor_gtk4_frame_surface_notify_surface_destroyed(surface->frame_surface);
+
+	libdecor_gtk4_tunnel_object_free(surface_tunnel_object);
+}
+
+static void
+surface_enter(void *data,
+	      struct wl_surface *wl_surface, struct wl_output *wl_output)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object = data;
+	struct libdecor_gtk4_tunnel_object *output =
+		wl_output_get_user_data(wl_output);
+
+	if (!own_output(wl_output))
+		return;
+
+	wl_surface_send_enter(surface_tunnel_object->resource,
+			      output->resource);
+}
+
+static void
+surface_leave(void *data,
+	      struct wl_surface *wl_surface, struct wl_output *wl_output)
+{
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object = data;
+	struct libdecor_gtk4_tunnel_object *output =
+		wl_output_get_user_data(wl_output);
+
+	if (!own_output(wl_output))
+		return;
+
+	wl_surface_send_leave(surface_tunnel_object->resource,
+			      output->resource);
+}
+
+static const struct wl_surface_listener surface_listener = {
+	surface_enter,
+	surface_leave
+};
+
+static void
+compositor_create_surface(struct wl_client *client,
+			  struct wl_resource *resource, uint32_t id)
+{
+	struct libdecor_gtk4_tunnel_object *compositor =
+		wl_resource_get_user_data(resource);
+	struct wl_surface *surface_proxy;
+	struct wl_resource *surface_resource;
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object;
+	struct libdecor_gtk4_surface *surface;
+
+	surface_proxy = wl_compositor_create_surface(compositor->proxy);
+	wl_proxy_set_tag((struct wl_proxy *) surface_proxy,
+			 &libdecor_gtk4_proxy_tag);
+	surface_resource =
+		wl_resource_create(client, &wl_surface_interface,
+				   wl_resource_get_version(resource), id);
+	surface_tunnel_object =
+		libdecor_gtk4_tunnel_object_new(compositor->tunnels,
+						compositor,
+						surface_proxy,
+						surface_resource);
+
+	wl_surface_add_listener(surface_proxy, &surface_listener,
+				surface_tunnel_object);
+	wl_resource_set_implementation(surface_resource, &surface_interface,
+				       surface_tunnel_object, destroy_surface);
+
+	surface = zalloc(sizeof *surface);
+	wl_signal_init(&surface->before_commit_signal);
+	wl_signal_init(&surface->after_commit_signal);
+
+	wl_list_init(&surface->pending_frame_callbacks);
+	surface->tunnel_object = surface_tunnel_object;
+	surface_tunnel_object->user_data = surface;
+	surface_tunnel_object->free_user_data = free;
+}
+
+static void
+destroy_region(struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(resource);
+
+	libdecor_gtk4_tunnel_object_free(region);
+}
+
+static void
+region_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(resource);
+
+	wl_region_destroy(region->proxy);
+	wl_resource_destroy(resource);
+}
+
+static void
+region_add(struct wl_client *client, struct wl_resource *resource,
+	   int32_t x, int32_t y, int32_t width, int32_t height)
+{
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(resource);
+
+	wl_region_add(region->proxy, x, y, width, height);
+}
+
+static void
+region_subtract(struct wl_client *client, struct wl_resource *resource,
+		int32_t x, int32_t y, int32_t width, int32_t height)
+{
+	struct libdecor_gtk4_tunnel_object *region =
+		wl_resource_get_user_data(resource);
+
+	wl_region_subtract(region->proxy, x, y, width, height);
+}
+
+static const struct wl_region_interface region_implementation = {
+	region_destroy,
+	region_add,
+	region_subtract
+};
+
+static void
+compositor_create_region(struct wl_client *client,
+			 struct wl_resource *resource, uint32_t id)
+{
+	struct libdecor_gtk4_tunnel_object *compositor =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_tunnel_object *region;
+	struct wl_region *region_proxy;
+	struct wl_resource *region_resource;
+
+	region_proxy = wl_compositor_create_region(compositor->proxy);
+	region_resource =
+		wl_resource_create(client, &wl_region_interface,
+				   wl_resource_get_version(resource), id);
+	region = libdecor_gtk4_tunnel_object_new(compositor->tunnels,
+						 compositor, region_proxy,
+						 region_resource);
+
+	wl_resource_set_implementation(region->resource, &region_implementation,
+				       region, destroy_region);
+}
+
+static const struct wl_compositor_interface compositor_implementation = {
+	compositor_create_surface,
+	compositor_create_region
+};
+
+static void
+destroy_compositor(struct wl_resource *resource)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object =
+		wl_resource_get_user_data(resource);
+
+	libdecor_gtk4_tunnel_object_free(tunnel_object);
+}
+
+static void
+bind_compositor(struct wl_client *client,
+		void *data, uint32_t version, uint32_t id)
+{
+	struct libdecor_gtk4_global *global = data;
+	struct libdecor_gtk4_tunnels *tunnels = global->tunnels;
+	struct libdecor_gtk4_tunnel_object *compositor;
+	struct wl_compositor *compositor_proxy;
+	struct wl_resource *compositor_resource;
+
+	compositor_proxy =
+		wl_registry_bind(tunnels->client.wl_registry,
+				 global->name,
+				 &wl_compositor_interface,
+				 version);
+	compositor_resource = wl_resource_create(client, &wl_compositor_interface,
+						 version, id);
+	compositor =
+		libdecor_gtk4_tunnel_object_new(tunnels,
+						tunnels->root_tunnel_object,
+						compositor_proxy,
+						compositor_resource);
+
+	wl_resource_set_implementation(compositor->resource, &compositor_implementation,
+				       compositor, destroy_compositor);
+}
+
+struct libdecor_gtk4_global *
+wl_compositor_new(struct libdecor_gtk4_tunnels *tunnels,
+		  uint32_t name,
+		  uint32_t version)
+{
+	struct libdecor_gtk4_global *global;
+	uint32_t tunneled_version;
+
+	global = zalloc(sizeof *global);
+	tunneled_version = MIN(version, MAX_COMPOSITOR_VERSION);
+	global->tunnels = tunnels;
+	global->name = name;
+	global->wl_global = wl_global_create(tunnels->server.wl_display,
+					     &wl_compositor_interface,
+					     tunneled_version,
+					     global, bind_compositor);
+	wl_list_insert(&tunnels->globals, &global->link);
+
+	return global;
+}
+
+static void
+seat_free(void *user_data)
+{
+	struct libdecor_gtk4_seat *seat = user_data;
+
+	free(seat->name);
+	free(seat);
+}
+
+static bool
+wl_seat_name_filter(struct wl_resource *resource,
+		    const char *name)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_seat *seat;
+
+	seat = tunnel_object->user_data;
+	if (!seat) {
+		seat = zalloc(sizeof(*seat));
+		seat->name = strdup(name);
+		tunnel_object->user_data = seat;
+		tunnel_object->free_user_data = seat_free;
+	}
+
+	return false;
+}
+
+static bool
+wl_pointer_enter_filter(struct wl_resource *pointer_resource,
+			uint32_t serial,
+			struct wl_resource *surface_resource,
+			wl_fixed_t x,
+			wl_fixed_t y)
+{
+	struct libdecor_gtk4_tunnel_object *pointer_tunnel_object =
+		wl_resource_get_user_data(pointer_resource);
+	struct libdecor_gtk4_tunnel_object *seat_tunnel_object =
+		pointer_tunnel_object->parent;
+	struct libdecor_gtk4_tunnel_object *surface_tunnel_object =
+		wl_resource_get_user_data(surface_resource);
+	struct libdecor_gtk4_seat *seat;
+
+	if (!surface_resource)
+		return false;
+
+	if (!own_surface(surface_tunnel_object->proxy))
+		return false;
+
+	seat = seat_tunnel_object->user_data;
+	if (seat) {
+		seat->pointer_focus = surface_tunnel_object->user_data;
+	}
+
+	return false;
+}
+
+static bool
+wl_pointer_leave_filter(struct wl_resource *pointer_resource,
+			uint32_t serial,
+			struct wl_resource *surface_resource)
+{
+	struct libdecor_gtk4_tunnel_object *pointer_tunnel_object =
+		wl_resource_get_user_data(pointer_resource);
+	struct libdecor_gtk4_tunnel_object *seat_tunnel_object =
+		pointer_tunnel_object->parent;
+	struct libdecor_gtk4_seat *seat;
+
+	seat = seat_tunnel_object->user_data;
+	if (seat) {
+		seat->pointer_focus = NULL;
+	}
+	return false;
+}
+
+static bool
+wl_pointer_button_filter(struct wl_resource *resource,
+			 uint32_t serial,
+			 uint32_t time,
+			 uint32_t button,
+			 uint32_t state)
+{
+	struct libdecor_gtk4_tunnel_object *pointer_tunnel_object =
+		wl_resource_get_user_data(resource);
+	struct libdecor_gtk4_tunnel_object *seat_tunnel_object =
+		pointer_tunnel_object->parent;
+	struct libdecor_gtk4_seat *seat;
+
+	seat = seat_tunnel_object->user_data;
+	if (!seat)
+		return false;
+
+	if (!seat->popup_grab)
+		return false;
+
+	if (!state)
+		return false;
+
+	if (seat->filter_next_release == button && !state) {
+		seat->filter_next_release = 0;
+		return true;
+	}
+
+	seat->filter_next_release = button;
+
+	libdecor_frame_dismiss_popup(seat->popup_grab, seat->name);
+	return true;
+}
+
+static void
+registry_handle_global(void *user_data,
+		       struct wl_registry *wl_registry,
+		       uint32_t id,
+		       const char *interface,
+		       uint32_t version)
+{
+	struct libdecor_gtk4_tunnels *tunnels = user_data;
+
+	if (strcmp(interface, "wl_compositor") == 0) {
+		wl_compositor_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_shm") == 0) {
+		wl_shm_new(tunnels, id, version);
+	} else if (strcmp(interface, "zwp_linux_dmabuf_v1") == 0) {
+		zwp_linux_dmabuf_v1_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_drm") == 0) {
+		wl_drm_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_seat") == 0) {
+		wl_seat_new(tunnels, id, version);
+	} else if (strcmp(interface, "zwp_tablet_manager_v2") == 0) {
+		zwp_tablet_manager_v2_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_data_device_manager") == 0) {
+		wl_data_device_manager_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_output") == 0) {
+		wl_output_new(tunnels, id, version);
+	} else if (strcmp(interface, "wp_cursor_shape_manager_v1") == 0) {
+		wp_cursor_shape_manager_v1_new(tunnels, id, version);
+	} else if (strcmp(interface, "wl_fixes") == 0) {
+		wl_fixes_new(tunnels, id, version);
+	}
+}
+
+static void
+registry_handle_global_remove(void *user_data,
+			      struct wl_registry *wl_registry,
+			      uint32_t name)
+{
+}
+
+static const struct wl_registry_listener registry_listener = {
+	registry_handle_global,
+	registry_handle_global_remove
+};
+
+struct libdecor_gtk4_tunnels *
+libdecor_gtk4_tunnels_new(struct libdecor_plugin_gtk4 *plugin_gtk4,
+			  struct wl_display *client_wl_display,
+			  struct wl_display *server_wl_display)
+{
+	struct libdecor_gtk4_tunnels *tunnels;
+
+	tunnels = zalloc(sizeof *tunnels);
+	tunnels->plugin_gtk4 = plugin_gtk4;
+	tunnels->client.wl_display = client_wl_display;
+
+	wl_list_init(&tunnels->globals);
+
+	tunnels->root_tunnel_object =
+		libdecor_gtk4_tunnel_object_new(tunnels, NULL, NULL, NULL);
+	tunnels->client.wl_registry = wl_display_get_registry(client_wl_display);
+	wl_registry_set_user_data(tunnels->client.wl_registry,
+				  tunnels->root_tunnel_object);
+	tunnels->server.wl_display = server_wl_display;
+	wl_registry_add_listener(tunnels->client.wl_registry,
+				 &registry_listener,
+				 tunnels);
+
+	tunnels->wl_seat_name_filter = wl_seat_name_filter;
+	tunnels->wl_pointer_enter_filter = wl_pointer_enter_filter;
+	tunnels->wl_pointer_leave_filter = wl_pointer_leave_filter;
+	tunnels->wl_pointer_button_filter = wl_pointer_button_filter;
+
+	return tunnels;
+}
+
+static void
+libdecor_gtk4_tunnel_object_free_tree(struct libdecor_gtk4_tunnel_object *tunnel_object)
+{
+	struct libdecor_gtk4_tunnel_object *child, *tmp;
+
+	wl_list_for_each_safe(child, tmp, &tunnel_object->children, link)
+		libdecor_gtk4_tunnel_object_free_tree(child);
+
+	if (tunnel_object->proxy)
+		wl_proxy_destroy(tunnel_object->proxy);
+
+	if (tunnel_object->resource)
+		wl_resource_destroy(tunnel_object->resource);
+	else
+		libdecor_gtk4_tunnel_object_free(tunnel_object);
+}
+
+void
+libdecor_gtk4_tunnels_free(struct libdecor_gtk4_tunnels *tunnels)
+{
+	struct libdecor_gtk4_global *global, *tmp;
+
+	wl_list_for_each_safe(global, tmp, &tunnels->globals, link)
+		libdecor_gtk4_global_free(global);
+
+	wl_registry_destroy(tunnels->client.wl_registry);
+	libdecor_gtk4_tunnel_object_free_tree(tunnels->root_tunnel_object);
+	free(tunnels);
+}
