+#ifndef LIBDECOR_GTK4_H
+#define LIBDECOR_GTK4_H
+
+#include <wayland-client-core.h>
+#include <wayland-server-core.h>
+
+#include "utils.h"
+
+struct wl_surface;
+struct wl_output;
+
+struct libdecor_gtk4_frame_surface;
+
+struct libdecor_gtk4_global {
+	struct libdecor_gtk4_tunnels *tunnels;
+
+	struct wl_list link;
+
+	uint32_t name;
+	struct wl_global *wl_global;
+};
+
+struct libdecor_gtk4_tunnels {
+	struct libdecor_plugin_gtk4 *plugin_gtk4;
+
+	struct {
+		struct wl_display *wl_display;
+		struct wl_registry *wl_registry;
+	} client;
+
+	struct {
+		struct wl_display *wl_display;
+	} server;
+
+	struct wl_list globals;
+
+	struct libdecor_gtk4_tunnel_object *root_tunnel_object;
+
+	bool (* wl_seat_name_filter)(struct wl_resource *resource,
+				     const char *name);
+	bool (* wl_pointer_enter_filter)(struct wl_resource *pointer_resource,
+					 uint32_t serial,
+					 struct wl_resource *surface_resource,
+					 wl_fixed_t x,
+					 wl_fixed_t y);
+	bool (* wl_pointer_leave_filter)(struct wl_resource *pointer_resource,
+					 uint32_t serial,
+					 struct wl_resource *surface_resource);
+	bool (* wl_pointer_button_filter)(struct wl_resource *resource,
+					  uint32_t serial,
+					  uint32_t time,
+					  uint32_t button,
+					  uint32_t state);
+};
+
+struct libdecor_gtk4_tunnel_object {
+	struct libdecor_gtk4_tunnels *tunnels;
+	struct libdecor_gtk4_tunnel_object *parent;
+	struct wl_list link;
+	struct wl_list children;
+	void *proxy;
+	void *resource;
+
+	void *user_data;
+	void (* free_user_data)(void *user_data);
+};
+
+struct libdecor_gtk4_seat {
+	char *name;
+
+	struct libdecor_gtk4_surface *pointer_focus;
+
+	struct libdecor_frame *popup_grab;
+	uint32_t filter_next_release;
+};
+
+struct libdecor_gtk4_surface {
+	struct libdecor_gtk4_tunnel_object *tunnel_object;
+
+	struct libdecor_gtk4_frame_surface *frame_surface;
+	struct wl_signal before_commit_signal;
+	struct wl_signal after_commit_signal;
+
+	struct wl_list pending_frame_callbacks;
+};
+
+struct libdecor_gtk4_callback {
+	struct libdecor_gtk4_tunnel_object *tunnel_object;
+	struct wl_list link;
+};
+
+struct libdecor_gtk4_tunnels *
+libdecor_gtk4_tunnels_new(struct libdecor_plugin_gtk4 *plugin_gtk4,
+			  struct wl_display *client_wl_display,
+			  struct wl_display *server_wl_display);
+
+void
+libdecor_gtk4_tunnels_free(struct libdecor_gtk4_tunnels *tunnels);
+
+struct libdecor_gtk4_tunnel_object *
+libdecor_gtk4_tunnel_object_new(struct libdecor_gtk4_tunnels *tunnels,
+				struct libdecor_gtk4_tunnel_object *parent,
+				void *proxy,
+				struct wl_resource *resource);
+
+void
+libdecor_gtk4_tunnel_object_free(struct libdecor_gtk4_tunnel_object *object);
+
+void
+libdecor_gtk4_frame_surface_notify_surface_destroyed(struct libdecor_gtk4_frame_surface *frame_surface);
+
+extern const char *libdecor_gtk4_proxy_tag;
+
+static inline bool
+own_proxy(struct wl_proxy *proxy)
+{
+	return proxy && (wl_proxy_get_tag(proxy) ==
+			 &libdecor_gtk4_proxy_tag);
+}
+
+static inline bool
+own_output(struct wl_output *output)
+{
+	return own_proxy((struct wl_proxy *) output);
+}
+
+static inline bool
+own_surface(struct wl_surface *surface)
+{
+	return own_proxy((struct wl_proxy *) surface);
+}
+
+#endif /* LIBDECOR_GTK4_H */
diff --git a/src/plugins/gtk4/libdecor-shell.xml b/src/plugins/gtk4/libdecor-shell.xml
