+static struct libdecor_frame *
+libdecor_plugin_gtk4_frame_new(struct libdecor_plugin *plugin)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 =
+		(struct libdecor_plugin_gtk4 *) plugin;
+	struct libdecor_frame_gtk4 *frame_gtk4;
