From 14b14b32532bbd4ee5544a42bd89f7f4a489a355 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Fri, 27 Mar 2026 14:13:05 +0100
Subject: [PATCH 06/20] demo: Fix redraw after state change

We'd miss redrawing when going e.g. inactive -> active, unless something
else triggered a redraw.
---
 demo/demo.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/demo/demo.c b/demo/demo.c
index 0faaeb1..e92e13e 100644
--- a/demo/demo.c
+++ b/demo/demo.c
@@ -1163,6 +1163,7 @@ handle_configure(struct libdecor_frame *frame,
 	int width, height;
 	enum libdecor_window_state window_state;
 	struct libdecor_state *state;
+	bool should_redraw = false;
 
 	/* Update window state first for the correct calculations */
 	if (!libdecor_configuration_get_window_state(configuration,
@@ -1178,9 +1179,22 @@ handle_configure(struct libdecor_frame *frame,
 	width = (width == 0) ? window->floating_width : width;
 	height = (height == 0) ? window->floating_height : height;
 
+	if (window->configured_width != width ||
+	    window->configured_height != height)
+		should_redraw = true;
+
 	window->configured_width = width;
 	window->configured_height = height;
 
+	if (!libdecor_configuration_get_window_state(configuration,
+						     &window_state))
+		window_state = LIBDECOR_WINDOW_STATE_NONE;
+
+	if (window->window_state != window_state)
+		should_redraw = true;
+
+	window->window_state = window_state;
+
 	state = libdecor_state_new(width, height);
 	libdecor_frame_commit(frame, state, configuration);
 	libdecor_state_free(state);
@@ -1191,7 +1205,10 @@ handle_configure(struct libdecor_frame *frame,
 		window->floating_height = height;
 	}
 
-	redraw(window);
+	if (should_redraw)
+		redraw(window);
+	else
+		wl_surface_commit(window->wl_surface);
 }
 
 static void
-- 
