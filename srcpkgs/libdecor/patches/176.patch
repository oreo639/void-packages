@@ -0,0 +1,55 @@
+<protocol name="libdecor_gtk4">
+
+  <interface name="libdecor_shell" version="1">
+    <request name="ready"/>
+
+    <request name="sync">
+      <arg name="callback" type="new_id" interface="wl_callback"/>
+    </request>
+
+    <request name="create_frame">
+      <arg name="frame_surface" type="new_id"
+	   interface="libdecor_shell_surface"/>
+      <arg name="serial" type="uint"/>
+      <arg name="surface" type="object" interface="wl_surface"/>
+    </request>
+
+    <request name="titlebar_geometry">
+      <arg name="height" type="uint"/>
+    </request>
+
+    <event name="request_frame">
+      <arg name="serial" type="uint"/>
+    </event>
+
+    <event name="terminate"/>
+  </interface>
+
+  <interface name="libdecor_shell_surface" version="1">
+    <request name="destroy" type="destructor"/>
+    <request name="close"/>
+
+    <request name="set_content_area">
+      <arg name="x" type="int"/>
+      <arg name="y" type="int"/>
+      <arg name="width" type="int"/>
+      <arg name="height" type="int"/>
+      <arg name="window_geometry_x" type="int"/>
+      <arg name="window_geometry_y" type="int"/>
+      <arg name="surface_width" type="int"/>
+      <arg name="surface_height" type="int"/>
+    </request>
+
+    <event name="configure_content">
+      <arg name="width" type="int"/>
+      <arg name="height" type="int"/>
+    </event>
+
+    <event name="configure_title">
+      <arg name="title" type="string"/>
+    </event>
+
+    <event name="dismiss"/>
+  </interface>
+
+</protocol>
diff --git a/src/plugins/gtk4/meson.build b/src/plugins/gtk4/meson.build
new file mode 100644
index 0000000..c66a9d5
--- /dev/null
+++ b/src/plugins/gtk4/meson.build
@@ -0,0 +1,242 @@
+wayland_server_dep = dependency('wayland-server', version: '>=1.20')
+
+wayland_protocols = [
+  {
+    'name': 'wayland',
+    'stability': 'core',
+    'no-wayland-scanner': true,
+    'filter': [
+      'wl_compositor',
+      'wl_display',
+      'wl_registry',
+      'wl_shell',
+      'wl_shell_surface',
+      'wl_subcompositor',
+      'wl_surface',
+    ],
+    'event-filters': [
+       ['wl_pointer', 'enter'],
+       ['wl_pointer', 'leave'],
+       ['wl_pointer', 'button'],
+       ['wl_seat', 'name'],
+    ]
+  },
+  {
+    'name': 'xdg-shell',
+    'stability': 'stable',
+    'no-tunnel': true,
+  },
+  {
+    'name': 'linux-dmabuf',
+    'stability': 'stable',
+    'version': '1',
+    'imports': ['wl_buffer'],
+  },
+  {
+    'name': 'tablet',
+    'stability': 'stable',
+    'version': '2',
+  },
+  {
+    'name': 'cursor-shape',
+    'stability': 'staging',
+    'version': '1',
+  },
+  {
+    'name': 'wayland-drm',
+    'stability': 'local',
+    'imports': ['wl_buffer'],
+  },
+  {
+    'name': 'libdecor-shell',
+    'stability': 'local',
+    'no-tunnel': true,
+  },
+]
+
+built_gtk4_sources = {}
+
+scanner = find_program('scanner.py')
+
+core_protocol_dir = wayland_server_dep.get_variable(pkgconfig: 'pkgdatadir')
+wayland_xml = core_protocol_dir / 'wayland.xml'
+
+tunnels = {}
+
+foreach p: wayland_protocols
+  stability = p['stability']
+  name = p['name']
+
+  assert(stability in ['core', 'stable', 'staging', 'unstable', 'local'],
+         'protocol \'@0@\' must be \'core\', \'stable\', \'staging\', \'unstable\' or \'local\''.format(name))
+
+  if stability == 'unstable'
+    suffix = '-unstable'
+  else
+    suffix = ''
+  endif
+  if p.has_key('version')
+    suffix += '-v@0@'.format(p['version'])
+  endif
+
+  output_base = name
+  if stability == 'local'
+    input = name+'.xml'
+  elif stability == 'core'
+    input = wayland_xml
+  else
+    input = join_paths(protocols_dir, stability, name, name+suffix+'.xml')
+  endif
+
+  client_header = custom_target('@0@ client header'.format(output_base),
+    input: input,
+    output: '@0@-client-protocol.h'.format(name + suffix),
+    command: [
+      wayland_scanner,
+      'client-header',
+      '@INPUT@', '@OUTPUT@',
+    ]
+  )
+  server_header = custom_target('@0@ server header'.format(output_base),
+    input: input,
+    output: '@0@-server-protocol.h'.format(name + suffix),
+    command: [
+      wayland_scanner,
+      'server-header',
+      '@INPUT@', '@OUTPUT@',
+    ]
+  )
+  protocol_source = custom_target('@0@ source'.format(output_base),
+    input: input,
+    output: '@0@-protocol.c'.format(name + suffix),
+    command: [
+      wayland_scanner,
+      'private-code',
+      '@INPUT@', '@OUTPUT@',
+    ]
+  )
+  if not p.has_key('no-wayland-scanner')
+    built_protocol_sources = [
+      client_header,
+      server_header,
+      protocol_source,
+    ]
+  else
+    built_protocol_sources = []
+  endif
+
+  if not p.has_key('no-tunnel')
+    depends = [server_header, client_header]
+    if p.has_key('imports')
+      extra_args = ['--import-from', wayland_xml]
+      foreach interface: p['imports']
+	extra_args += ['--import', interface]
+      endforeach
+      depends += tunnels['wayland']
+    else
+      extra_args = []
+    endif
+    if p.has_key('filter')
+      foreach filter: p['filter']
+	extra_args += ['--filter', filter]
+      endforeach
+    endif
+    if p.has_key('event-filters')
+      foreach event_filter: p['event-filters']
+	extra_args += [
+	  '--filter-event',
+	  '@0@.@1@'.format(event_filter[0], event_filter[1]),
+	]
+      endforeach
+    endif
+    tunnel_header = custom_target('@0@ tunnel header'.format(output_base),
+      input: input,
+      output: '@0@-tunnel.h'.format(name + suffix),
+      depend_files: scanner.full_path(),
+      capture: true,
+      command: [
+	scanner,
+	'--header',
+	'@INPUT@',
+      ],
+    )
+    tunnel_code = custom_target('@0@ tunnel code'.format(output_base),
+      input: input,
+      output: '@0@-tunnel.c'.format(name + suffix),
+      depends: depends,
+      depend_files: scanner.full_path(),
+      capture: true,
+      command: [
+	scanner,
+	'--code',
+	extra_args,
+	'@INPUT@',
+      ],
+    )
+    tunnels += { name: [tunnel_header, tunnel_code] }
+    built_protocol_sources += [
+      tunnel_header,
+      tunnel_code,
+    ]
+  endif
+  built_gtk4_sources += {name: built_protocol_sources}
+endforeach
+
+built_plugin_sources = [
+  built_gtk4_sources['wayland'],
+  built_gtk4_sources['linux-dmabuf'],
+  built_gtk4_sources['xdg-shell'],
+  built_gtk4_sources['wayland-drm'],
+  built_gtk4_sources['tablet'],
+  built_gtk4_sources['cursor-shape'],
+  built_gtk4_sources['libdecor-shell'],
+]
+
+shared_module('decor-gtk4',
+  sources: [
+    'libdecor-gtk4.c',
+    'libdecor-gtk4-tunnels.c',
+    built_plugin_sources,
+  ],
+  include_directories: [
+    top_includepath,
+    libdecor_includepath,
+    plugin_include_path,
+  ],
+  dependencies: [
+    libdecor_dep,
+    wayland_client_dep,
+    wayland_server_dep,
+    os_utils_dep,
+  ],
+  install_dir: join_paths(plugindir),
+  install: true,
+)
+
+built_client_sources = [
+  built_gtk4_sources['linux-dmabuf'][0],
+  built_gtk4_sources['linux-dmabuf'][2],
+  built_gtk4_sources['xdg-shell'][0],
+  built_gtk4_sources['xdg-shell'][2],
+  built_gtk4_sources['libdecor-shell'][0],
+  built_gtk4_sources['libdecor-shell'][2],
+]
+
+executable('libdecor-gtk4-client',
+  sources: [
+    'libdecor-gtk4-client.c',
+    built_client_sources,
+  ],
+  include_directories: [
+    top_includepath,
+    libdecor_includepath,
+    plugin_include_path,
+  ],
+  dependencies: [
+    gtk4_dep,
+    math_dep,
+    wayland_client_dep,
+  ],
+  install_dir: join_paths(plugindir),
+  install: true,
+)
