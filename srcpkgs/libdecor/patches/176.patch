+static struct libdecor_frame_gtk4 *
+find_frame(struct libdecor_plugin_gtk4 *plugin_gtk4,
+	   uint32_t serial)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4;
+
+	wl_list_for_each(frame_gtk4, &plugin_gtk4->pending_frames, link) {
+		if (frame_gtk4->serial == serial) {
+			wl_list_remove(&frame_gtk4->link);
+			wl_list_init(&frame_gtk4->link);
+			return frame_gtk4;
+		}
+	}
+
+	return NULL;
+}
