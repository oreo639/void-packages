Subject: [PATCH 14/20] Call notify_property_changed() on wm capability changes

---
 src/libdecor.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/libdecor.c b/src/libdecor.c
index 3ee1c45..2c3b04f 100644
--- a/src/libdecor.c
+++ b/src/libdecor.c
@@ -546,8 +546,12 @@ xdg_toplevel_wm_capabilities(void *user_data,
 {
 	struct libdecor_frame *frame = user_data;
 	struct libdecor_frame_private *frame_priv = frame->priv;
+	struct libdecor *context = frame_priv->context;
+	struct libdecor_plugin *plugin = context->plugin;
 	enum xdg_toplevel_wm_capabilities *wm_cap;
+	enum libdecor_wm_capabilities old_wm_capabilities;
 
+	old_wm_capabilities = frame_priv->wm_capabilities;
 	frame_priv->wm_capabilities = 0;
 
 	wl_array_for_each(wm_cap, capabilities) {
@@ -568,6 +572,9 @@ xdg_toplevel_wm_capabilities(void *user_data,
 			break;
 		}
 	}
+
+	if (old_wm_capabilities != frame_priv->wm_capabilities)
+		plugin->priv->iface->frame_property_changed(plugin, frame);
 }
 #endif
 
