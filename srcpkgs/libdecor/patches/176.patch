new file mode 100755
index 0000000..732d2a9
--- /dev/null
+++ b/src/plugins/gtk4/scanner.py
@@ -0,0 +1,671 @@
+#!/usr/bin/env python3
+
+import os
+import sys
+import argparse
+import xml.etree.ElementTree as ET
+from dataclasses import dataclass, field
+from typing import List, Optional
+
+interface_map = {}
+event_filters = []
+nl = "\n"
+cnl = ",\n"
+
+
+@dataclass
+class Argument:
+    name: str
+    type: str
+    interface: Optional[str] = None
+
+    def get_ctype_server(self):
+        if self.type == "int":
+            return "int32_t"
+        elif self.type == "uint":
+            return "uint32_t"
+        elif self.type == "fixed":
+            return "wl_fixed_t"
+        elif self.type == "string":
+            return "const char *"
+        elif self.type == "fd":
+            return "int"
+        elif self.type == "object":
+            return "struct wl_resource *"
+        elif self.type == "array":
+            return "struct wl_array *"
+        elif self.type == "new_id":
+            return None
+
+    def get_ctype_client(self):
+        if self.type == "int":
+            return "int32_t"
+        elif self.type == "uint":
+            return "uint32_t"
+        elif self.type == "fixed":
+            return "wl_fixed_t"
+        elif self.type == "string":
+            return "const char *"
+        elif self.type == "fd":
+            return "int"
+        elif self.type == "object":
+            return f"struct {self.interface} *"
+        elif self.type == "array":
+            return "struct wl_array *"
+        elif self.type == "new_id":
+            return f"struct {self.interface} *"
+
+
+@dataclass
+class Request:
+    name: str
+    arguments: List[Argument] = field(default_factory=list)
+    is_destructor: bool = False
+    creates_interface: Optional[str] = None
+
+
+@dataclass
+class Event:
+    name: str
+    arguments: List[Argument] = field(default_factory=list)
+    is_destructor: bool = False
+    creates_interface: Optional[str] = None
+
+
+@dataclass
+class Interface:
+    name: str
+    version: int
+    requests: List[Request] = field(default_factory=list)
+    events: List[Event] = field(default_factory=list)
+    is_global: bool = False
+
+
+def parse_argument(arg_elem: ET.Element) -> Argument:
+    return Argument(
+        name=arg_elem.get("name", ""),
+        type=arg_elem.get("type", ""),
+        interface=arg_elem.get("interface"),
+    )
+
+
+def parse_request(req_elem: ET.Element) -> Request:
+    arguments = [parse_argument(arg) for arg in req_elem.findall("arg")]
+
+    creates_interface = None
+    for arg in arguments:
+        if arg.type == "new_id" and arg.interface:
+            creates_interface = arg.interface
+            break
+
+    return Request(
+        name=req_elem.get("name", ""),
+        arguments=arguments,
+        is_destructor=req_elem.get("type") == "destructor",
+        creates_interface=creates_interface,
+    )
+
+
+def parse_event(evt_elem: ET.Element) -> Event:
+    arguments = [parse_argument(arg) for arg in evt_elem.findall("arg")]
+
+    creates_interface = None
+    for arg in arguments:
+        if arg.type == "new_id" and arg.interface:
+            creates_interface = arg.interface
+            break
+
+    return Event(
+        name=evt_elem.get("name", ""),
+        arguments=arguments,
+        is_destructor=evt_elem.get("type") == "destructor",
+        creates_interface=creates_interface,
+    )
+
+
+def parse_interface(iface_elem: ET.Element) -> Interface:
+    requests = [parse_request(req) for req in iface_elem.findall("request")]
+    events = [parse_event(evt) for evt in iface_elem.findall("event")]
+
+    return Interface(
+        name=iface_elem.get("name", ""),
+        version=int(iface_elem.get("version", "1")),
+        requests=requests,
+        events=events,
+    )
+
+
+def parse_wayland_xml(
+    file_path: str,
+    filter_interfaces: Optional[set] = None,
+    only_interfaces: Optional[set] = None,
+) -> List[Interface]:
+    tree = ET.parse(file_path)
+    root = tree.getroot()
+
+    protocol_name = root.get("name")
+
+    if filter_interfaces is None:
+        filter_interfaces = set()
+
+    interfaces = []
+    for iface_elem in root.findall("interface"):
+        iface_name = iface_elem.get("name", "")
+        if only_interfaces:
+            if iface_name in only_interfaces:
+                interfaces.append(parse_interface(iface_elem))
+        else:
+            if iface_name not in filter_interfaces:
+                interfaces.append(parse_interface(iface_elem))
+
+    created_interfaces = set()
+    for interface in interfaces:
+        for request in interface.requests:
+            if request.creates_interface:
+                created_interfaces.add(request.creates_interface)
+        for event in interface.events:
+            if event.creates_interface:
+                created_interfaces.add(event.creates_interface)
+
+    for interface in interfaces:
+        interface.is_global = interface.name not in created_interfaces
+
+    return (protocol_name, interfaces)
+
+
+def generate_interface_declarations(interface):
+    if interface.requests:
+        print(
+            f"const struct {interface.name}_listener {interface.name}_implementation;"
+        )
+    if interface.events:
+        print(f"const struct {interface.name}_listener {interface.name}_listener;")
+    print("")
+
+
+def should_filter(interface, event):
+    return (interface.name, event.name) in event_filters
+
+
+def process_interface(interface):
+    parts = []
+    for request in interface.requests:
+        parts += [
+            f"""
+static void
+{interface.name}_process_{request.name}(
+"""
+        ]
+        passed_args = list(
+            filter(lambda arg: arg.get_ctype_server(), request.arguments)
+        )
+        proxy_args = [
+            """
+		tunnel_object->proxy"""
+        ]
+        for arg in passed_args:
+            if arg.type == "object":
+                proxy_args += [f"		{arg.name}_tunnel_object->proxy"]
+            else:
+                proxy_args += ["		" + arg.name]
+
+        function_args = [
+            "	struct wl_client *wl_client",
+            "	struct wl_resource *resource",
+        ]
+        if request.creates_interface:
+            function_args += ["	uint32_t id"]
+        for arg in passed_args:
+            function_args += [f"	{arg.get_ctype_server()} {arg.name}"]
+        parts += [",\n".join(function_args)]
+        parts += [
+            """)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object =
+		wl_resource_get_user_data(resource);"""
+        ]
+
+        for arg in passed_args:
+            if arg.type == "object":
+                parts += [
+                    f"""
+	struct libdecor_gtk4_tunnel_object *{arg.name}_tunnel_object =
+		wl_resource_get_user_data({arg.name});"""
+                ]
+
+        if request.creates_interface:
+            new_interface = interface_map[request.creates_interface]
+            parts += [
+                f"""
+	struct libdecor_gtk4_tunnels *tunnels = tunnel_object->tunnels;
+	struct libdecor_gtk4_tunnel_object *new_tunnel_object;
+	struct {new_interface.name} *new_proxy;
+	struct wl_resource *new_resource;
+	int version = wl_resource_get_version(resource);
+
+	new_proxy = {interface.name}_{request.name}({cnl.join(proxy_args)});
+	wl_proxy_set_tag((struct wl_proxy *) new_proxy,
+			 &libdecor_gtk4_proxy_tag);
+	new_resource = wl_resource_create(wl_client,
+					  &{new_interface.name}_interface,
+					  version, id);
+	new_tunnel_object =
+		libdecor_gtk4_tunnel_object_new(tunnels, tunnel_object,
+						new_proxy, new_resource);
+"""
+            ]
+            if new_interface.requests:
+                parts += [
+                    f"""
+	wl_resource_set_implementation(new_resource,
+				       &{new_interface.name}_implementation,
+				       new_tunnel_object,
+				       destroy_{new_interface.name});
+"""
+                ]
+            else:
+                parts += [
+                    f"""
+	wl_resource_set_implementation(new_resource, NULL,
+				       new_tunnel_object, destroy_{new_interface.name});
+"""
+                ]
+            if new_interface.events:
+                parts += [
+                    f"""
+	{new_interface.name}_add_listener(new_proxy,
+		&{new_interface.name}_listener,
+		new_tunnel_object);{nl}"""
+                ]
+        else:
+            parts += [
+                f"{nl}{nl}	{interface.name}_{request.name}({cnl.join(proxy_args)});{nl}"
+            ]
+
+        if request.is_destructor:
+            parts += [f"{nl}	wl_resource_destroy(tunnel_object->resource);{nl}"]
+
+        for arg in passed_args:
+            if arg.type == "fd":
+                parts += [
+                    f"""
+	close({arg.name});
+"""
+                ]
+
+        parts += ["}\n"]
+
+    if interface.requests:
+        parts += [
+            f"""
+const struct {interface.name}_interface {interface.name}_implementation = {{
+    """
+        ]
+        request_handlers = []
+        for request in interface.requests:
+            request_handlers += [f"	{interface.name}_process_{request.name}"]
+        parts += [",\n".join(request_handlers)]
+        parts += ["\n};\n"]
+
+    for event in interface.events:
+        parts += [
+            f"""
+static void
+{interface.name}_handle_{event.name}(
+"""
+        ]
+        passed_args = list(filter(lambda arg: arg.get_ctype_client(), event.arguments))
+        proxy_args = [
+            """
+                tunnel_object->resource"""
+        ]
+        for arg in passed_args:
+            if arg.type == "object":
+                proxy_args += [
+                    f"		{arg.interface}_tunnel_object ? {arg.interface}_tunnel_object->resource : NULL"
+                ]
+            elif arg.type == "new_id":
+                proxy_args += [f"		new_tunnel_object->resource"]
+            else:
+                proxy_args += [f"		{arg.name}"]
+
+        function_args = [
+            "	void *data",
+            f"	struct {interface.name} *proxy",
+        ]
+        if event.creates_interface:
+            function_args += [f"	struct {event.creates_interface} *new_proxy"]
+        for arg in passed_args:
+            if arg.type == "object":
+                function_args += [f"	{arg.get_ctype_client()} {arg.name}"]
+            elif arg.type == "new_id":
+                pass
+            else:
+                function_args += [f"	{arg.get_ctype_client()} {arg.name}"]
+        parts += [",\n".join(function_args)]
+        parts += [
+            """)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object = data;"""
+        ]
+
+        for arg in passed_args:
+            if arg.type == "object":
+                parts += [
+                    f"""
+	struct libdecor_gtk4_tunnel_object *{arg.interface}_tunnel_object =
+			{arg.name} ? {arg.interface}_get_user_data({arg.name}) : NULL;"""
+                ]
+
+        if event.creates_interface:
+            new_interface = interface_map[event.creates_interface]
+            parts += [
+                f"""
+	struct libdecor_gtk4_tunnels *tunnels = tunnel_object->tunnels;
+	struct wl_resource *new_resource;
+		struct libdecor_gtk4_tunnel_object *new_tunnel_object;
+
+	new_resource = wl_resource_create(wl_resource_get_client(tunnel_object->resource),
+					  &{new_interface.name}_interface,
+					  wl_resource_get_version(tunnel_object->resource),
+					  0);
+	wl_proxy_set_tag((struct wl_proxy *) new_proxy,
+			 &libdecor_gtk4_proxy_tag);
+	new_tunnel_object =
+		libdecor_gtk4_tunnel_object_new(tunnels,
+						tunnel_object,
+						new_proxy,
+ 						new_resource);
+"""
+            ]
+            if new_interface.requests:
+                parts += [
+                    f"""
+	wl_resource_set_implementation(new_resource,
+				       &{new_interface.name}_implementation,
+				       new_tunnel_object, destroy_{new_interface.name});
+"""
+                ]
+            if new_interface.events:
+                parts += [
+                    f"""
+	{new_interface.name}_add_listener(new_proxy,
+		&{new_interface.name}_listener,
+		new_tunnel_object);"""
+                ]
+
+        for surface_arg in filter(
+            lambda arg: arg.type == "object" and arg.interface == "wl_surface",
+            passed_args,
+        ):
+            parts += [
+                f"""
+
+	if (!own_surface({surface_arg.name}))
+		return;"""
+            ]
+
+        if should_filter(interface, event):
+            parts += [
+                f"""
+
+	if (tunnel_object->tunnels->{interface.name}_{event.name}_filter({cnl.join(proxy_args)}))
+		goto filtered;"""
+            ]
+
+        parts += [
+            f"""
+
+	{interface.name}_send_{event.name}({cnl.join(proxy_args)});
+"""
+        ]
+
+        if should_filter(interface, event):
+            parts += ["filtered:\n"]
+        if event.is_destructor:
+            parts += [
+                f"""
+	wl_proxy_destroy(tunnel_object->proxy);
+	wl_resource_destroy(tunnel_object->resource);
+"""
+            ]
+
+        for arg in passed_args:
+            if arg.type == "fd":
+                parts += [
+                    f"""
+	close({arg.name});
+"""
+                ]
+        parts += [
+            f"""}}
+"""
+        ]
+
+    if interface.events:
+        parts += [
+            f"""
+const struct {interface.name}_listener {interface.name}_listener = {{
+    """
+        ]
+        event_handlers = []
+        for event in interface.events:
+            event_handlers += [f"	{interface.name}_handle_{event.name}"]
+        parts += [",\n".join(event_handlers)]
+        parts += ["\n};\n"]
+
+    parts += [
+        f"""
+LIBDECOR_PRIVATE void
+destroy_{interface.name}(struct wl_resource *resource)
+{{
+	struct libdecor_gtk4_tunnel_object *tunnel_object =
+		wl_resource_get_user_data(resource);
+"""
+    ]
+
+    parts += [
+        """
+	libdecor_gtk4_tunnel_object_free(tunnel_object);
+}"""
+    ]
+
+    print("".join(parts))
+
+
+def process_global(interface):
+    global_binder_parts = [
+        f"""static void
+bind_{interface.name}(struct wl_client *client,
+		      void *data, uint32_t version, uint32_t id)
+{{
+	struct libdecor_gtk4_global *global = data;
+	struct libdecor_gtk4_tunnels *tunnels = global->tunnels;
+	struct {interface.name} *proxy;
+	struct wl_resource *resource;
+	struct libdecor_gtk4_tunnel_object *tunnel_object;
+
+	proxy = wl_registry_bind(global->tunnels->client.wl_registry,
+				 global->name,
+				 &{interface.name}_interface,
+				 version);
+	resource = wl_resource_create(client,
+				      &{interface.name}_interface,
+				      version, id);
+	tunnel_object =
+		libdecor_gtk4_tunnel_object_new(tunnels,
+						tunnels->root_tunnel_object,
+						proxy,
+						resource);
+"""
+    ]
+
+    if interface.events:
+        global_binder_parts += [
+            f"""
+	{interface.name}_add_listener(proxy,
+		&{interface.name}_listener,
+		tunnel_object);
+"""
+        ]
+
+    if interface.requests:
+        global_binder_parts += [
+            f"""
+	wl_resource_set_implementation(resource,
+				       &{interface.name}_implementation,
+				       tunnel_object,
+				       destroy_{interface.name});
+"""
+        ]
+    global_binder_parts += "}"
+
+    global_binder = "\n".join(global_binder_parts)
+
+    global_constructor = f"""
+{global_binder}
+
+struct libdecor_gtk4_global *
+{interface.name}_new(struct libdecor_gtk4_tunnels *tunnels,
+	uint32_t id,
+	uint32_t max_version)
+{{
+	struct libdecor_gtk4_global *global;
+	uint32_t tunneled_version;
+
+	global = zalloc(sizeof *global);
+	tunneled_version = MIN(max_version, {interface.version});
+	global->tunnels = tunnels;
+	global->name = id;
+	global->wl_global = wl_global_create(tunnels->server.wl_display,
+	    &{interface.name}_interface,
+	    tunneled_version,
+	    global, bind_{interface.name});
+
+	wl_list_insert(&tunnels->globals, &global->link);
+
+	return global;
+}}"""
+    print(global_constructor)
+
+
+def process_global_declaration(interface):
+    global_declaration = f"""struct libdecor_gtk4_global *
+{interface.name}_new(struct libdecor_gtk4_tunnels *tunnels,
+	uint32_t id,
+	uint32_t max_version);
+"""
+    print(global_declaration)
+
+
+def main():
+    """Main function to parse and display Wayland protocol information."""
+    parser = argparse.ArgumentParser(
+        description="Parse Wayland protocol XML files and extract interfaces, requests, and events."
+    )
+    parser.add_argument("xml_file", help="Path to the Wayland XML protocol file")
+    parser.add_argument(
+        "-f",
+        "--filter",
+        action="append",
+        dest="filters",
+        metavar="INTERFACE",
+        help="Filter out an interface by name. Can be specified multiple times.",
+    )
+    parser.add_argument(
+        "--import-from", metavar="PATH", help="Path to the XMl file to import from."
+    )
+    parser.add_argument(
+        "--import",
+        action="append",
+        dest="imports",
+        metavar="INTERFACE",
+        help="Import intarface core interface boiler plate. Can be specified multiple times.",
+    )
+    parser.add_argument("--code", action="store_true", help="Generated C code.")
+    parser.add_argument("--header", action="store_true", help="Generated C header.")
+    parser.add_argument(
+        "--filter-event",
+        action="append",
+        default=[],
+        dest="event_filters",
+        metavar="INTERFACE.EVENT",
+        help="Pass these events through a filter.",
+    )
+
+    args = parser.parse_args()
+
+    filter_set = set(args.filters) if args.filters else set()
+    try:
+        if args.imports:
+            imported_protocol_name, imported_interfaces = parse_wayland_xml(
+                args.import_from, None, set(args.imports)
+            )
+        else:
+            imported_interfaces = []
+        protocol_name, interfaces = parse_wayland_xml(args.xml_file, None, None)
+    except FileNotFoundError:
+        print(f"Error: File '{args.xml_file}' not found", file=sys.stderr)
+        sys.exit(1)
+    except ET.ParseError as e:
+        print(f"Error parsing XML: {e}", file=sys.stderr)
+        sys.exit(1)
+
+    for event_filter in args.event_filters:
+        global event_filters
+        interface, event = event_filter.split(".")
+        event_filters += [(interface, event)]
+
+    if args.code:
+        include_basename = os.path.basename(args.xml_file).removesuffix(".xml")
+        for interface in interfaces:
+            interface_map[interface.name] = interface
+        for interface in imported_interfaces:
+            interface_map[interface.name] = interface
+
+        print("#include <stdlib.h>")
+        print("#include <unistd.h>")
+        print("")
+        print('#include "libdecor-gtk4.h"')
+        print("")
+        if protocol_name == "wayland":
+            print("#include <wayland-client-core.h>")
+            print("#include <wayland-server-core.h>")
+        else:
+            print("#include <wayland-client.h>")
+            print("#include <wayland-server.h>")
+        print("")
+        print(f'#include "{include_basename}-client-protocol.h"')
+        print(f'#include "{include_basename}-server-protocol.h"')
+        if args.imports:
+            print('#include "wayland-tunnel.h"')
+        print(f'#include "{include_basename}-tunnel.h"')
+        print("")
+
+        for interface in interfaces:
+            if interface.name not in filter_set:
+                process_interface(interface)
+
+        for interface in interfaces:
+            if interface.name not in filter_set:
+                if interface.is_global:
+                    process_global(interface)
+    elif args.header:
+        print("#pragma once")
+        print("")
+        print("#include <wayland-server-core.h>")
+        for interface in interfaces:
+            if interface.name not in filter_set:
+                print(
+                    f"""
+extern const struct {interface.name}_interface {interface.name}_implementation;
+void destroy_{interface.name}(struct wl_resource *resource);
+extern const struct {interface.name}_listener {interface.name}_listener;
+    """
+                )
+                if interface.is_global:
+                    process_global_declaration(interface)
+
+
+if __name__ == "__main__":
+    main()
