Date: Mon, 30 Mar 2026 16:19:17 +0200
Subject: [PATCH 19/20] gtk4: Allow specifying client executable

This is useful when building libdecor as a 32 bit library on a 64 bit
system, so one can compile the necassary client side dependencies only
for the 64 bit architecture.
---
 config.h.meson                   |  3 +++
 meson.build                      | 11 ++++++++-
 meson_options.txt                |  5 ++++
 src/plugins/gtk4/libdecor-gtk4.c |  5 ++++
 src/plugins/gtk4/meson.build     | 39 +++++++++++++++++---------------
 src/plugins/meson.build          |  9 ++++++--
 6 files changed, 51 insertions(+), 21 deletions(-)

diff --git a/config.h.meson b/config.h.meson
index d64f7ad..83ad78f 100644
--- a/config.h.meson
+++ b/config.h.meson
@@ -7,6 +7,9 @@
 /* Plugin API version */
 #mesondefine LIBDECOR_PLUGIN_API_VERSION
 
+/* Path to GTK4 client executable */
+#mesondefine LIBDECOR_PLUGIN_GTK4_CLIENT_PATH
+
 #mesondefine HAS_DBUS
 
 #mesondefine HAVE_MKOSTEMP
diff --git a/meson.build b/meson.build
index 1e92328..608501d 100644
--- a/meson.build
+++ b/meson.build
@@ -1,6 +1,6 @@
 project('libdecor', 'c',
   version: '0.2.2',
-  meson_version: '>= 0.55.0',
+  meson_version: '>= 1.1.0',
   license: 'MIT',
   default_options: [
     'c_std=c99',
@@ -74,6 +74,15 @@ cdata.set('LIBDECOR_PLUGIN_API_VERSION', plugin_api_version)
 if dbus_dep.found()
   cdata.set('HAS_DBUS', true)
 endif
+if get_option('gtk4').enabled()
+  libdecor_gtk4_client_name = 'libdecor-gtk4-client'
+  if get_option('gtk4_client') == ''
+    libdecor_gtk4_client_path = plugindir / libdecor_gtk4_client_name
+  else
+    libdecor_gtk4_client_path = get_option('gtk4_client')
+  endif
+  cdata.set_quoted('LIBDECOR_PLUGIN_GTK4_CLIENT_PATH', libdecor_gtk4_client_path)
+endif
 
 if cc.has_function('mkostemp', prefix: '#include <stdlib.h>')
   cdata.set('HAVE_MKOSTEMP', true)
diff --git a/meson_options.txt b/meson_options.txt
index 90395be..57f0239 100644
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -7,3 +7,8 @@ option('install_demo', type: 'boolean', value: false, description: 'install demo
 option('gtk', type: 'feature', value: 'enabled', description: 'build GTK plugin')
 
 option('gtk4', type: 'feature', value: 'enabled', description: 'build GTK4 plugin')
+
+option('gtk4_client', type: 'string', value: '',
+  description: 'Path to gtk4 external plugin client. The client must of the ' +
+               'exact same version as the plugin itself, but can have ' +
+	       'another architecture.')
diff --git a/src/plugins/gtk4/libdecor-gtk4.c b/src/plugins/gtk4/libdecor-gtk4.c
index 1f00d38..a034291 100644
--- a/src/plugins/gtk4/libdecor-gtk4.c
+++ b/src/plugins/gtk4/libdecor-gtk4.c
@@ -1581,6 +1581,11 @@ find_client_path(void)
 
 	plugin_dir_env = getenv("LIBDECOR_PLUGIN_DIR");
 	if (!plugin_dir_env) {
+		if (access(LIBDECOR_PLUGIN_GTK4_CLIENT_PATH, R_OK | X_OK) == 0) {
+			client_path = strdup(LIBDECOR_PLUGIN_GTK4_CLIENT_PATH);
+			goto out;
+		}
+	} else {
 		plugin_dir_env = LIBDECOR_PLUGIN_DIR;
 	}
 
diff --git a/src/plugins/gtk4/meson.build b/src/plugins/gtk4/meson.build
index c66a9d5..31c77cb 100644
--- a/src/plugins/gtk4/meson.build
+++ b/src/plugins/gtk4/meson.build
@@ -222,21 +222,24 @@ built_client_sources = [
   built_gtk4_sources['libdecor-shell'][2],
 ]
 
-executable('libdecor-gtk4-client',
-  sources: [
-    'libdecor-gtk4-client.c',
-    built_client_sources,
-  ],
-  include_directories: [
-    top_includepath,
-    libdecor_includepath,
-    plugin_include_path,
-  ],
-  dependencies: [
-    gtk4_dep,
-    math_dep,
-    wayland_client_dep,
-  ],
-  install_dir: join_paths(plugindir),
-  install: true,
-)
+client = get_option('gtk4_client')
+if client == ''
+  executable(libdecor_gtk4_client_name,
+    sources: [
+      'libdecor-gtk4-client.c',
+      built_client_sources,
+    ],
+    include_directories: [
+      top_includepath,
+      libdecor_includepath,
+      plugin_include_path,
+    ],
+    dependencies: [
+      gtk4_dep,
+      math_dep,
+      wayland_client_dep,
+    ],
+    install_dir: join_paths(plugindir),
+    install: true,
+  )
+endif
diff --git a/src/plugins/meson.build b/src/plugins/meson.build
index e300b29..ca6ecb1 100644
--- a/src/plugins/meson.build
+++ b/src/plugins/meson.build
@@ -1,5 +1,5 @@
 gtk_dep = dependency('gtk+-3.0', required: get_option('gtk'))
-gtk4_dep = dependency('gtk4', required: get_option('gtk4'))
+gtk4_dep = dependency('gtk4', required: false)
 
 plugin_include_path = include_directories('.')
 
@@ -11,6 +11,11 @@ if gtk_dep.found()
   subdir('gtk')
 endif
 
-if gtk4_dep.found()
+get_option('gtk4').enable_auto_if(gtk4_dep.found() or get_option('gtk4_client') != '')
+
+if get_option('gtk4').enabled()
+  if not gtk4_dep.found()
+    error('gtk4 plugin enabled but gtk4 not found')
+  endif
   subdir('gtk4')
 endif
-- 
