+static void
+handle_surface_before_commit(struct wl_listener *listener, void *data)
+{
+}
+
+static void
+handle_surface_after_commit(struct wl_listener *listener, void *data)
+{
+	struct libdecor_gtk4_frame_surface *frame_surface =
+		wl_container_of(listener, frame_surface,
+				after_commit_listener);
+	struct libdecor_frame *frame = &frame_surface->frame_gtk4->frame;
+	
+	frame_surface->current_state = frame_surface->pending_state;
+
+	if (frame && frame_surface->is_sync && !frame_surface->in_commit)
+		libdecor_frame_toplevel_commit(frame);
+}
+
+static struct libdecor_gtk4_frame_surface *
+libdecor_gtk4_frame_surface_new(struct libdecor_gtk4_surface *surface)
+{
+	struct libdecor_gtk4_frame_surface *frame_surface;
+
+	frame_surface = zalloc(sizeof *frame_surface);
+	frame_surface->ref_count = 1;
+	frame_surface->surface = surface;
+	frame_surface->is_sync = true;
+
+	frame_surface->before_commit_listener.notify = handle_surface_before_commit;
+	wl_signal_add(&surface->before_commit_signal,
+		      &frame_surface->before_commit_listener);
+	frame_surface->after_commit_listener.notify = handle_surface_after_commit;
+	wl_signal_add(&surface->after_commit_signal,
+		      &frame_surface->after_commit_listener);
+
+	frame_surface->plugin_gtk4 = surface->tunnel_object->tunnels->plugin_gtk4;
+
+	surface->frame_surface = frame_surface;
+
+	return frame_surface;
+}
+
+static struct libdecor_gtk4_frame_surface *
+libdecor_gtk4_frame_surface_ref(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	frame_surface->ref_count++;
+	return frame_surface;
+}
+
+static void
+libdecor_gtk4_frame_surface_unref(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	frame_surface->ref_count--;
+	if (frame_surface->ref_count == 0) {
+		assert(!frame_surface->server.shell_surface_resource);
+		assert(!frame_surface->server.xdg_surface_resource);
+		assert(!frame_surface->server.xdg_toplevel_resource);
+		free(frame_surface);
+	}
+}
+
+void
+libdecor_gtk4_frame_surface_notify_surface_destroyed(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	frame_surface->surface = NULL;
+}
+
+static struct libdecor_frame_gtk4 *
+libdecor_frame_gtk4_new(struct libdecor_plugin_gtk4 *plugin_gtk4)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4;
+	static uint32_t frame_serial = 0;
+
+	frame_gtk4 = zalloc(sizeof *frame_gtk4);
+	frame_gtk4->plugin_gtk4 = plugin_gtk4;
+	frame_gtk4->serial = ++frame_serial;
+
+	wl_list_insert(&plugin_gtk4->pending_frames, &frame_gtk4->link);
+	libdecor_shell_send_request_frame(plugin_gtk4->shell.resource,
+					  frame_gtk4->serial);
+
+	while (!frame_gtk4->frame_surface)
+		libdecor_plugin_gtk4_dispatch(&plugin_gtk4->plugin, -1);
+
+	return frame_gtk4;
+}
