From 7f988290c33da761b378592962014fa5d76ae6fd Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jonas=20=C3=85dahl?= <jadahl@gmail.com>
Date: Mon, 30 Mar 2026 15:25:51 +0200
Subject: [PATCH 18/20] gtk4: Reflect content resizability in the GTK client

This means non-resizable windows wont get the resize pointer cursors
while hovering the edges.
---
 src/plugins/gtk4/libdecor-gtk4-client.c | 12 ++++++++++++
 src/plugins/gtk4/libdecor-gtk4.c        | 22 ++++++++++++++++++++++
 src/plugins/gtk4/libdecor-shell.xml     |  4 ++++
 3 files changed, 38 insertions(+)

diff --git a/src/plugins/gtk4/libdecor-gtk4-client.c b/src/plugins/gtk4/libdecor-gtk4-client.c
index ab8dbef..fd99a0b 100644
--- a/src/plugins/gtk4/libdecor-gtk4-client.c
+++ b/src/plugins/gtk4/libdecor-gtk4-client.c
@@ -241,6 +241,17 @@ libdecor_shell_surface_handle_configure_title(void *data,
 	gtk_window_set_title(GTK_WINDOW(frame_window->window), title);
 }
 
+static void
+libdecor_shell_surface_handle_configure_resizable(void *data,
+						  struct libdecor_shell_surface *libdecor_shell_surface,
+						  int32_t is_resizable)
+{
+	struct frame_window *frame_window = data;
+
+	gtk_window_set_resizable(GTK_WINDOW(frame_window->window),
+				 is_resizable);
+}
+
 static void
 libdecor_shell_surface_handle_dismiss(void *data,
 				      struct libdecor_shell_surface *libdecor_shell_surface)
@@ -253,6 +264,7 @@ libdecor_shell_surface_handle_dismiss(void *data,
 static struct libdecor_shell_surface_listener libdecor_shell_surface_listener = {
 	.configure_content = libdecor_shell_surface_handle_configure_content,
 	.configure_title = libdecor_shell_surface_handle_configure_title,
+	.configure_resizable = libdecor_shell_surface_handle_configure_resizable,
 	.dismiss = libdecor_shell_surface_handle_dismiss,
 };
 
diff --git a/src/plugins/gtk4/libdecor-gtk4.c b/src/plugins/gtk4/libdecor-gtk4.c
index c892534..1f00d38 100644
--- a/src/plugins/gtk4/libdecor-gtk4.c
+++ b/src/plugins/gtk4/libdecor-gtk4.c
@@ -79,6 +79,7 @@ struct libdecor_frame_gtk4 {
 
 	char *title;
 	enum libdecor_wm_capabilities wm_capabilities;
+	enum libdecor_capabilities capabilities;
 };
 
 struct libdecor_plugin_gtk4 {
@@ -764,6 +765,20 @@ send_wm_capabilities(struct libdecor_gtk4_frame_surface *frame_surface)
 	wl_array_release(&xdg_wm_capabilities);
 }
 
+static void
+send_capabilities(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 = frame_surface->frame_gtk4;
+	struct wl_resource *shell_surface =
+		frame_surface->server.shell_surface_resource;
+	int32_t is_resizable;
+
+	is_resizable = libdecor_frame_has_capability(&frame_gtk4->frame,
+						     LIBDECOR_ACTION_RESIZE);
+	libdecor_shell_surface_send_configure_resizable(shell_surface,
+							is_resizable);
+}
+
 static void
 libdecor_plugin_gtk4_frame_property_changed(struct libdecor_plugin *plugin,
 					    struct libdecor_frame *frame)
@@ -787,6 +802,13 @@ libdecor_plugin_gtk4_frame_property_changed(struct libdecor_plugin *plugin,
 			libdecor_frame_get_wm_capabilities(frame);
 		send_wm_capabilities(frame_surface);
 	}
+
+	if (libdecor_frame_get_capabilities(frame) !=
+	    frame_gtk4->capabilities) {
+		frame_gtk4->capabilities =
+			libdecor_frame_get_capabilities(frame);
+		send_capabilities(frame_surface);
+	}
 }
 
 static struct libdecor_gtk4_seat *
diff --git a/src/plugins/gtk4/libdecor-shell.xml b/src/plugins/gtk4/libdecor-shell.xml
index 27458a4..0cdb29a 100644
--- a/src/plugins/gtk4/libdecor-shell.xml
+++ b/src/plugins/gtk4/libdecor-shell.xml
@@ -45,6 +45,10 @@
       <arg name="height" type="int"/>
     </event>
 
+    <event name="configure_resizable">
+      <arg name="resizable" type="int"/>
+    </event>
+
     <event name="configure_title">
       <arg name="title" type="string"/>
     </event>
