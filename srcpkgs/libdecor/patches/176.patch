+	frame_gtk4 = libdecor_frame_gtk4_new(plugin_gtk4);
+
+	return &frame_gtk4->frame;
+}
+
+static void
+libdecor_plugin_gtk4_frame_free(struct libdecor_plugin *plugin,
+				struct libdecor_frame *frame)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_gtk4_frame_surface *frame_surface;
+
+	frame_surface = frame_gtk4->frame_surface;
+	if (frame_surface) {
+		struct wl_resource *resource;
+
+		resource = frame_surface->server.shell_surface_resource;
+		libdecor_shell_surface_send_dismiss(resource);
+		wl_list_remove(&frame_surface->before_commit_listener.link);
+		wl_list_remove(&frame_surface->after_commit_listener.link);
+		frame_surface->frame_gtk4 = NULL;
+		frame_gtk4->frame_surface = NULL;
+
+		while (frame_surface->surface) {
+			dispatch_pending_frame_callbacks(frame_surface);
+			dispatch_plugin_only(frame_gtk4->plugin_gtk4);
+		}
+	}
+
+	wl_list_remove(&frame_gtk4->link);
+	wl_list_init(&frame_gtk4->link);
+	free(frame_gtk4->title);
+	frame_gtk4->title = NULL;
+}
+
+static void
+add_uint32_to_array(struct wl_array *states,
+		    uint32_t value)
+{
+  uint32_t *valuep;
+
+  valuep = wl_array_add(states, sizeof(*valuep));
+  *valuep = value;
+}
+
+static void
+set_states_array(struct wl_array *states,
+		 enum libdecor_window_state window_state)
+{
+	if (window_state & LIBDECOR_WINDOW_STATE_ACTIVE)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_ACTIVATED);
+	if (window_state & LIBDECOR_WINDOW_STATE_MAXIMIZED)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_MAXIMIZED);
+	if (window_state & LIBDECOR_WINDOW_STATE_FULLSCREEN)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_FULLSCREEN);
+	if (window_state & LIBDECOR_WINDOW_STATE_TILED_LEFT)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_TILED_LEFT);
+	if (window_state & LIBDECOR_WINDOW_STATE_TILED_RIGHT)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_TILED_RIGHT);
+	if (window_state & LIBDECOR_WINDOW_STATE_TILED_TOP)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_TILED_TOP);
+	if (window_state & LIBDECOR_WINDOW_STATE_TILED_BOTTOM)
+		add_uint32_to_array(states, XDG_TOPLEVEL_STATE_TILED_BOTTOM);
+}
+
+static struct libdecor_gtk4_frame_surface *
+create_frame_surface(struct libdecor_frame_gtk4 *frame_gtk4)
+{
+	struct libdecor_plugin_gtk4 *plugin_gtk4 = frame_gtk4->plugin_gtk4;
+
+	if (frame_gtk4->frame_surface)
+		return frame_gtk4->frame_surface;
+
+	wl_list_insert(&plugin_gtk4->pending_frames, &frame_gtk4->link);
+	libdecor_shell_send_request_frame(plugin_gtk4->shell.resource,
+					  frame_gtk4->serial);
+
+	while (!frame_gtk4->frame_surface)
+		dispatch_plugin_only(plugin_gtk4);
+	return frame_gtk4->frame_surface;
+}
+
+static void
+update_subsurface_position(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	int x;
+	int y; 
+
+	x = -(frame_surface->current_state.content_area_x +
+	      frame_surface->current_state.window_geometry_x);
+	y = -(frame_surface->current_state.content_area_y +
+	      frame_surface->current_state.window_geometry_y);
+
+	if (frame_surface->subsurface_x == x &&
+	    frame_surface->subsurface_y == y)
+		return;
+
+	frame_surface->subsurface_x = x;
+	frame_surface->subsurface_y = y;
+
+	wl_subsurface_set_position(frame_surface->client.subsurface, x, y);
+}
+
+static void
+dispatch_pending_frame_callbacks(struct libdecor_gtk4_frame_surface *frame_surface)
+{
+	struct libdecor_gtk4_callback *callback, *tmp;
+
+	wl_list_for_each_safe(callback, tmp,
+			      &frame_surface->surface->pending_frame_callbacks,
+			      link) {
+		wl_callback_send_done(callback->tunnel_object->resource, 0);
+		wl_callback_destroy(callback->tunnel_object->proxy);
+		wl_resource_destroy(callback->tunnel_object->resource);
+	}
+}
+
+static void
+libdecor_plugin_gtk4_frame_commit(struct libdecor_plugin *plugin,
+				  struct libdecor_frame *frame,
+				  struct libdecor_state *state,
+				  struct libdecor_configuration *configuration)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_plugin_gtk4 *plugin_gtk4 =
+		(struct libdecor_plugin_gtk4 *) plugin;
+	struct libdecor_gtk4_frame_surface *frame_surface;
+	struct wl_resource *shell_surface;
+	struct wl_array states;
+	enum libdecor_window_state new_window_state;
+	uint32_t pending_configure_serial;
+	int width = 0, height = 0;
+
+	if (frame_gtk4->frame_surface) {
+		frame_surface = frame_gtk4->frame_surface;
+		shell_surface = frame_surface->server.shell_surface_resource;
+	} else {
+		const char *title;
+
+		frame_surface = create_frame_surface(frame_gtk4);
+		shell_surface = frame_surface->server.shell_surface_resource;
+
+		title = libdecor_frame_get_title(frame);
+		libdecor_shell_surface_send_configure_title(shell_surface, title);
+	}
+
+	frame_surface->in_commit = true;
+
+	wl_array_init(&states);
+	new_window_state = libdecor_frame_get_window_state(frame);
+	set_states_array(&states, new_window_state);
+
+	configuration = libdecor_frame_get_configuration(frame);
+	if (configuration) {
+		libdecor_configuration_get_window_size(configuration,
+						       frame,
+						       &width, &height);
+	}
+
+	if (configuration &&
+	    !libdecor_configuration_is_fixed_size(configuration)) {
+		int content_width, content_height;
+
+		content_width = libdecor_frame_get_content_width(frame);
+		content_height = libdecor_frame_get_content_height(frame);
+		libdecor_shell_surface_send_configure_content(shell_surface,
+							      content_width,
+							      content_height);
+	} else {
+		libdecor_shell_surface_send_configure_content(shell_surface,
+							      0, 0);
+	}
+
+	xdg_toplevel_send_configure(frame_surface->server.xdg_toplevel_resource,
+				    width, height, &states);
+	wl_array_release(&states);
+
+	pending_configure_serial = ++frame_surface->last_sent_configure_serial;
+	xdg_surface_send_configure(frame_surface->server.xdg_surface_resource,
+				   pending_configure_serial);
+
+
+	if (!frame_surface->client.subsurface) {
+		frame_surface->client.subsurface =
+			wl_subcompositor_get_subsurface(plugin_gtk4->client.wl_subcompositor,
+							frame_surface->surface->tunnel_object->proxy,
+							libdecor_frame_get_wl_surface(frame));
+		wl_subsurface_place_below(frame_surface->client.subsurface,
+					  libdecor_frame_get_wl_surface(frame));
+	}
+
+	while (frame_surface->current_state.acked_configure_serial !=
+	       pending_configure_serial) {
+		dispatch_pending_frame_callbacks(frame_surface);
+		dispatch_plugin_only(plugin_gtk4);
+	}
+
+	update_subsurface_position(frame_surface);
+
+	frame_surface->in_commit = false;
+}
+
+static void
+libdecor_plugin_gtk4_frame_property_changed(struct libdecor_plugin *plugin,
+					    struct libdecor_frame *frame)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_gtk4_frame_surface *frame_surface = frame_gtk4->frame_surface;
+	struct wl_resource *shell_surface =
+		frame_surface->server.shell_surface_resource;
+	const char *title;
+
+	title = libdecor_frame_get_title(frame);
+	if (libdecor_strcmp0(frame_gtk4->title, title) != 0) {
+		set_string(&frame_gtk4->title, title);
+		libdecor_shell_surface_send_configure_title(shell_surface, title);
+	}
+}
+
+static struct libdecor_gtk4_seat *
+find_seat(struct libdecor_plugin_gtk4 *plugin_gtk4,
+	  const char *name)
+{
+	struct libdecor_gtk4_tunnel_object *tunnel_object;
+
+	wl_list_for_each(tunnel_object,
+			 &plugin_gtk4->tunnels->root_tunnel_object->children,
+			 link) {
+		struct libdecor_gtk4_seat *seat;
+
+		if (wl_resource_get_interface(tunnel_object->resource) !=
+		    &wl_seat_interface)
+			continue;
+
+		seat = tunnel_object->user_data;
+		if (!seat)
+			continue;
+
+		if (strcmp(seat->name, name) == 0)
+			return seat;
+	}
+
+	return NULL;
+}
+
+static void
+libdecor_plugin_gtk4_frame_popup_grab(struct libdecor_plugin *plugin,
+				      struct libdecor_frame *frame,
+				      const char *seat_name)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_gtk4_seat *seat;
+
+	seat = find_seat(frame_gtk4->plugin_gtk4, seat_name);
+	if (!seat) {
+		fprintf(stderr,
+			"libdecor-WARNING: Application tried to grab unknown seat\n");
+		return;
+	}
+
+	if (seat->popup_grab) {
+		fprintf(stderr, "libdecor-WARNING: Application "
+			"tried to grab seat twice\n");
+	}
+	seat->popup_grab = frame;
+	return;
+}
+
+static void
+libdecor_plugin_gtk4_frame_popup_ungrab(struct libdecor_plugin *plugin,
+					struct libdecor_frame *frame,
+					const char *seat_name)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_gtk4_seat *seat;
+
+	seat = find_seat(frame_gtk4->plugin_gtk4, seat_name);
+	if (!seat) {
+		fprintf(stderr,
+			"libdecor-WARNING: Application tried to grab unknown seat\n");
+		return;
+	}
+
+	if (seat->popup_grab != frame) {
+		fprintf(stderr, "libdecor-WARNING: Application "
+			"tried to grab seat twice\n");
+	}
+	seat->popup_grab = NULL;
+	return;
+}
+
+static bool
+libdecor_plugin_gtk4_frame_get_border_size(struct libdecor_plugin *plugin,
+					   struct libdecor_frame *frame,
+					   struct libdecor_configuration *configuration,
+					   int *left,
+					   int *right,
+					   int *top,
+					   int *bottom)
+{
+	struct libdecor_frame_gtk4 *frame_gtk4 =
+		(struct libdecor_frame_gtk4 *) frame;
+	struct libdecor_gtk4_frame_surface *frame_surface = frame_gtk4->frame_surface;
+	enum libdecor_window_state window_state;
+
+	if (configuration) {
+		if (!libdecor_configuration_get_window_state(
+			    configuration, &window_state))
+			return false;
+	} else {
+		window_state = libdecor_frame_get_window_state(frame);
+	}
+
+	if (window_state & LIBDECOR_WINDOW_STATE_FULLSCREEN) {
+		if (left)
+			*left = 0;
+		if (right)
+			*right = 0;
+		if (top)
+			*top = 0;
+		if (bottom)
+			*bottom = 0;
+	} else {
+		if (left)
+			*left = 0;
+		if (right)
+			*right = 0;
+		if (top)
+			*top = frame_surface->plugin_gtk4->titlebar_height;
+		if (bottom)
+			*bottom = 0;
+	}
+
+	return true;
+}
