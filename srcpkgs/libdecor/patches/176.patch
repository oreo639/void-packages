+static bool
+frame_surface_state_equals(struct frame_surface_state *state1,
+			   struct frame_surface_state *state2)
+{
+	return (state1->content_area_x == state2->content_area_x &&
+		state1->content_area_y == state2->content_area_y &&
+		state1->content_area_width == state2->content_area_width &&
+		state1->content_area_height == state2->content_area_height &&
+		state1->window_geometry_x == state2->window_geometry_x &&
+		state1->window_geometry_y == state2->window_geometry_y &&
+		state1->surface_width == state2->surface_width &&
+		state1->surface_height == state2->surface_height);
+}
+
+static void
+libdecor_shell_surface_handle_set_content_area(struct wl_client *client,
+					       struct wl_resource *resource,
+					       int32_t x,
+					       int32_t y,
+					       int32_t width,
+					       int32_t height,
+					       int32_t window_geometry_x,
+					       int32_t window_geometry_y,
+					       int32_t surface_width,
+					       int32_t surface_height)
+{
+	struct libdecor_gtk4_frame_surface *frame_surface = wl_resource_get_user_data(resource);
+	bool should_sync;
+
+
+	frame_surface->pending_state.content_area_x = x;
+	frame_surface->pending_state.content_area_y = y;
+	frame_surface->pending_state.content_area_width = width;
+	frame_surface->pending_state.content_area_height = height;
+	frame_surface->pending_state.window_geometry_x = window_geometry_x;
+	frame_surface->pending_state.window_geometry_y = window_geometry_y;
+	frame_surface->pending_state.surface_width = surface_width;
+	frame_surface->pending_state.surface_height = surface_height;
+
+	should_sync = !frame_surface_state_equals(&frame_surface->pending_state,
+						  &frame_surface->current_state);
+	if (should_sync != frame_surface->is_sync) {
+		if (should_sync)
+			wl_subsurface_set_sync(frame_surface->client.subsurface);
+		else
+			wl_subsurface_set_desync(frame_surface->client.subsurface);
+		frame_surface->is_sync = should_sync;
+	}
+}
