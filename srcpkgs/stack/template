# Template file for 'stack'
pkgname=stack
version=3.1.1
revision=1
_stackage="lts-23.14"
hostmakedepends="cabal-install pkg-config unzip"
makedepends="zlib-devel pcre-devel"
depends="git gmp-devel iana-etc"
short_desc="Cross-platform program for developing Haskell projects"
maintainer="Leah Neukirchen <leah@vuxu.org>"
license="BSD-3-Clause"
homepage="https://haskellstack.org"
distfiles="https://hackage.haskell.org/package/${pkgname}-${version}/${pkgname}-${version}.tar.gz
 https://www.stackage.org/${_stackage}/cabal.config>cabal.config-${_stackage}"
checksum="c4af01eab0fe6e423b0ac71d53d1447f0e605a96fa021fd77c9518f5983d5d45
 b85942092af3fc75a7a781dfd72c7100ff97856b471d8a4bda0f0b7e01e2dfcf"
skip_extraction="cabal.config-${_stackage}"
nocross=yes
nopie_files="/usr/bin/stack"

build_options="refreeze"
desc_option_refreeze="Update cabal dependency freeze file"

post_patch() {
	vsed -e '/with-compiler/d' -i cabal.project
	cp ${XBPS_SRCDISTDIR}/${pkgname}-${version}/cabal.config-${_stackage} cabal.config
}

pre_configure() {
	if [ "$build_option_refreeze" ]; then
		HOME=$PWD cabal v2-update
		(
			HOME=$PWD cabal v2-freeze \
				--shadow-installed-packages --flag disable-git-info \
				--constraint 'lukko -ofd-locking'  # https://github.com/haskell/cabal/issues/7313
			mv cabal.project.freeze "$FILESDIR"
		)
	fi

	cp $FILESDIR/cabal.project.freeze .
}

do_build() {
	HOME=$PWD cabal v2-update
	HOME=$PWD cabal v2-build ${makejobs} --flag disable-git-info \
		--constraint 'lukko -ofd-locking'  # https://github.com/haskell/cabal/issues/7313
}

do_install() {
	eval vbin dist-newstyle/build/*/*/*/build/stack/stack
	vlicense LICENSE
}
